---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";

const hero = {
  headingWhite: "Marketing support you can",
  headingGreen: "actually afford.",
  body: "Strategy, branding, and websites. Packaged into clear offers with clear outcomes.",
  cta: [
    {
      label: "Book a call",
      href: "https://meetings-eu1.hubspot.com/taz-b",
      variant: "primary",
    },
    {
      label: "View our work",
      href: "/case-study",
      variant: "secondary",
    },
  ],
};

const packages = [
  {
    name: "Free",
    description:
      "For founders who want to improve LinkedIn themselves before deciding on done-for-you support.",
    price: "£0",
    period: "/mo",
    note: "Free for founders. No credit card required.",
    buttonText: "Get started for free",
    buttonHref: "/leadgen",
    includes: [
      "Free community support",
      "Free strategy tools",
      "Free lead gen tools",
      "Free content tools",
      "Free design tools",
    ],
  },
  {
    name: "Pipeline Growth",
    badge: "Starts at",
    description:
      "For companies with a proven service that need a predictable outbound LinkedIn pipeline.",
    price: "£400",
    period: "/mo",
    note: "Predictable outbound system. No long-term lock-in.",
    buttonText: "Find out more",
    buttonHref: "/services/social-selling",
    includes: [
      "ICP research and targeting",
      "Lead list build and formatting",
      "Messaging strategy",
      "Outreach setup",
      "Campaign launch, monitoring, and optimisation",
      "Inbox management",
      "Follow-ups",
      "Lead nurturing",
      "Support with handling sales presentations",
      "KPI Reporting",
    ],
  },
  {
    name: "Personal Branding",
    badge: "Starts at",
    description:
      "For founders who are ready to show up as the face of the business but want guidance and execution support.",
    price: "£600",
    period: "/mo",
    note: "Dedicated ghostwriting & high-touch brand guidance.",
    buttonText: "Find out more",
    buttonHref: "/services/personal-branding",
    includes: [
      "LinkedIn profile optimisation",
      "Personality questionnaire",
      "Content strategy",
      "Research and idea development",
      "3-4 high-quality posts each week",
      "Notion teamspace",
      "15 rewrites",
      "Visual templates",
      "LinkedIn commenting",
    ],
  },
  {
    name: "Website Build",
    badge: "Project rate",
    description:
      "For businesses whose website and brand message need to catch up with how good their service has become.",
    price: "£1,000",
    period: "",
    note: "Fixed one-off investment. Complete handover.",
    buttonText: "Find out more",
    buttonHref: "/services/web-brand-positioning",
    includes: [
      "Discovery",
      "Research",
      "Messaging",
      "Build",
      "Revisions",
      "Launch",
      "Handover",
    ],
  },
];
---

<Layout>
  <!-- Hero Section -->
  <section class="bg-brand-navy pt-20 pb-32 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto flex flex-col items-start">
      <h1
        class="text-5xl md:text-7xl lg:text-7xl xl:text-[80px] font-heading mb-8 font-semibold leading-[1.05] text-white"
      >
        {hero.headingWhite}<br />
        <span class="text-brand-green">{hero.headingGreen}</span>
      </h1>

      <p
        class="text-xl md:text-2xl lg:text-3xl font-body max-w-5xl mb-12 text-white font-light lg:leading-snug"
      >
        {hero.body}
      </p>

      <div
        class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-6"
      >
        {
          hero.cta.map((btn) => (
            <Button
              href={btn.href}
              variant={btn.variant as "primary" | "secondary"}
            >
              {btn.label}
            </Button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pricing Cards Section -->
  <section class="bg-gray-50 text-brand-navy py-24 px-8">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-heading text-4xl md:text-5xl mb-6">
          Simple, straightforward pricing
        </h2>
        <p class="font-body text-xl max-w-3xl mx-auto text-gray-600">
          Everything you need to scale your LinkedIn presence, generate
          qualified pipeline, and build a high-converting website.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
        {
          packages.map((pkg) => (
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 flex flex-col h-full">
              <!-- Top Details: Name & Description -->
              <h3 class="font-heading text-2xl font-bold mb-4">{pkg.name}</h3>
              <p class="font-body text-sm text-gray-600 mb-8 min-h-[70px]">
                {pkg.description}
              </p>

              <!-- Price Box -->
              <div class="mb-4">
                {pkg.badge && (
                  <p class="text-xs uppercase tracking-wider text-gray-400 font-bold mb-1">
                    {pkg.badge}
                  </p>
                )}
                <span class="text-4xl font-heading font-black">{pkg.price}</span>
                {pkg.period && (
                  <span class="text-gray-500 font-body">{pkg.period}</span>
                )}
              </div>
              <p class="text-sm font-body text-gray-500 mb-8 min-h-[40px]">
                {pkg.note}
              </p>

              <!-- Action Button -->
              <a
                href={pkg.buttonHref}
                class="bg-brand-blue text-white w-full py-3 rounded text-center font-bold font-heading hover:bg-blue-700 transition-colors mb-8"
              >
                {pkg.buttonText}
              </a>

              <!-- Includes Checklist aligned directly under button (card background stretches equally) -->
              <div class="pt-4 border-t border-gray-100 flex-grow">
                <p class="font-bold text-sm mb-4 font-body">Includes:</p>
                <ul class="space-y-3 font-body text-sm text-gray-700">
                  {pkg.includes.map((feature) => (
                    <li class="flex items-start">
                      <span class="text-brand-green mr-2 font-bold shrink-0">✓</span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
