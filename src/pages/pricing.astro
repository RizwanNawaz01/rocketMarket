---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";

const hero = {
  headingWhite: "Marketing support you can",
  headingGreen: "actually afford.",
  body: "Strategy, branding, and websites. Packaged into clear offers with clear outcomes.",
  cta: [
    {
      label: "Book a call",
      href: "https://meetings-eu1.hubspot.com/taz-b",
      variant: "primary",
    },
    {
      label: "View our work",
      href: "/case-study",
      variant: "secondary",
    },
  ],
};

const packages = [
  {
    name: "Free",
    description:
      "For founders who want to improve LinkedIn themselves before deciding on done-for-you support.",
    price: "£0",
    period: "/mo",
    note: "Free for founders. No credit card required.",
    buttonText: "Get started for free",
    buttonHref: "/leadgen",
    includes: [
      "Free community support",
      "Free strategy tools",
      "Free lead gen tools",
      "Free content tools",
      "Free design tools",
    ],
  },
  {
    name: "Social Selling",
    badge: "Starts at",
    description:
      "For companies with a proven service that need a predictable outbound LinkedIn pipeline.",
    price: "£400",
    period: "/mo",
    note: "Predictable outbound system. No long-term lock-in.",
    buttonText: "Find out more",
    buttonHref: "/services/social-selling",
    includes: [
      "ICP research and targeting",
      "Lead list build and formatting",
      "Messaging strategy",
      "Outreach setup",
      "Campaign launch, monitoring, and optimisation",
      "Inbox management",
      "Follow-ups",
      "Lead nurturing",
      "Support with handling sales presentations",
      "KPI Reporting",
    ],
  },
  {
    name: "Personal Branding",
    badge: "Starts at",
    description:
      "For founders who are ready to show up as the face of the business but want guidance and execution support.",
    price: "£600",
    period: "/mo",
    note: "Dedicated ghostwriting & high-touch brand guidance.",
    buttonText: "Find out more",
    buttonHref: "/services/personal-branding",
    includes: [
      "LinkedIn profile optimisation",
      "Personality questionnaire",
      "Content strategy",
      "Research and idea development",
      "3-4 high-quality posts each week",
      "Notion teamspace",
      "15 rewrites",
      "Visual templates",
      "LinkedIn commenting",
    ],
  },
  {
    name: "Website Build",
    badge: "Project rate",
    description:
      "For businesses whose website and brand message need to catch up with how good their service has become.",
    price: "£1,000",
    period: "",
    note: "Fixed one-off investment. Complete handover.",
    buttonText: "Find out more",
    buttonHref: "/services/web-brand-positioning",
    includes: [
      "Discovery",
      "Research",
      "Messaging",
      "Build",
      "Revisions",
      "Launch",
      "Handover",
    ],
  },
];
---

<Layout>
  <!-- Hero Section -->
  <section class="bg-brand-navy pt-20 pb-24 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto flex flex-col items-start">
      <h1
        class="text-5xl md:text-7xl lg:text-7xl xl:text-[80px] font-heading mb-8 font-semibold leading-[1.05] text-white"
      >
        {hero.headingWhite}<br />
        <span class="text-brand-green">{hero.headingGreen}</span>
      </h1>

      <p class="hero-subtext max-w-5xl mb-12">
        {hero.body}
      </p>

      <div
        class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-6"
      >
        {
          hero.cta.map((btn) => (
            <Button
              href={btn.href}
              variant={btn.variant as "primary" | "secondary"}
            >
              {btn.label}
            </Button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pricing Cards Section with light blue background -->
  <section class="bg-[#eef6f9] text-brand-navy py-20 px-8">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-heading text-4xl md:text-5xl mb-6 font-bold text-brand-navy">
          Simple, straightforward pricing
        </h2>
        <p class="font-body text-xl max-w-3xl mx-auto text-gray-700">
          Everything you need to scale your LinkedIn presence, generate
          qualified pipeline, and build a high-converting website.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
        {
          packages.map((pkg) => (
            <div class="bg-white rounded-2xl shadow-sm border border-sky-100 p-8 flex flex-col justify-between h-full">
              <!-- Top Section: Titles & description -->
              <div>
                <h3 class="font-heading text-xl lg:text-[21px] font-bold mb-3 min-h-[56px] flex items-start">
                  {pkg.name}
                </h3>
                <p class="font-body text-sm text-gray-600 mb-6 min-h-[96px] sm:min-h-[80px] lg:min-h-[105px]">
                  {pkg.description}
                </p>

                <!-- Badge -->
                <p class="text-xs uppercase tracking-wider text-gray-400 font-bold mb-1.5 h-4">
                  {pkg.badge || ""}
                </p>

                <!-- Price Box -->
                <div class="mb-4 h-11 flex items-baseline">
                  <span class="text-4xl font-heading font-black text-brand-navy leading-none">
                    {pkg.price}
                  </span>
                  {pkg.period && (
                    <span class="text-gray-500 font-body text-sm ml-0.5">
                      {pkg.period}
                    </span>
                  )}
                </div>

                <!-- Note description -->
                <p class="text-xs font-body text-gray-500 mb-6 min-h-[40px] lg:min-h-[48px]">
                  {pkg.note}
                </p>

                <!-- Action Button aligned across all cards -->
                <a
                  href={pkg.buttonHref}
                  class="bg-brand-blue text-white w-full py-3 px-4 rounded-lg block text-center font-bold font-heading hover:bg-blue-700 transition-colors mb-8 text-sm shadow-sm"
                >
                  {pkg.buttonText}
                </a>
              </div>

              <!-- Includes Checklist aligned directly at bottom -->
              <div class="pt-6 border-t border-gray-100 flex-grow flex flex-col">
                <p class="font-bold text-sm mb-4 font-body text-brand-navy">Includes:</p>
                <ul class="space-y-3 font-body text-sm text-gray-700 flex-grow">
                  {pkg.includes.map((feature) => (
                    <li class="flex items-start">
                      <span class="text-brand-green mr-2.5 font-bold shrink-0 text-base leading-none">✓</span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
