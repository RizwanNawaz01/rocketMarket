---
import Layout from "../layouts/Layout.astro";
import CTABanner from "../components/CTABanner.astro";
import Button from "../components/Button.astro";

const hero = {
  headingWhite: "B2B Marketing Costs:",
  headingGreen: "Honest Guide",
  emoji: "💸",
  body: "Quality B2B marketing doesn’t come cheap. Agency fees, overheads, experienced teams, and proven results all carry a price tag. For many founders and growing consultancy businesses, those numbers can feel out of reach.",
};

const marketRates = [
  {
    service: "LinkedIn Profile Refresh",
    low: "£300",
    mid: "£800",
    premium: "£2,000+",
  },
  {
    service: "LinkedIn Content Management",
    low: "£750",
    mid: "£1,500",
    premium: "£2,250 /mo",
  },
  {
    service: "Outreach / Lead Gen",
    low: "£500",
    mid: "£1,200",
    premium: "£2,000 /mo",
  },
  {
    service: "Template Website",
    low: "£1,500",
    mid: "£2,500",
    premium: "£4,000+",
  },
  {
    service: "Custom Website Build",
    low: "£8,000",
    mid: "£15,000",
    premium: "£20,000+",
  },
  {
    service: "LinkedIn Ads Management",
    low: "£900",
    mid: "£1,500",
    premium: "£2,250 /mo*",
  },
];

const priceDrivers = [
  {
    number: "1",
    title: "Research & Market Understanding",
    body: "Businesses may come to us looking for a logo or website when what they truly need first is clarity: who you serve, what makes you different, and why that matters. This is where we bring proven experience - we know how to uncover and articulate that sharp positioning.\n\nWe also know research is foundational. That’s why standard market and competitor research is included by default with our core services.\n\nFor deeper, more extensive analysis, we offer an enhanced research add-on if you want to go further.",
  },
  {
    number: "2",
    title: "Scope, Deliverables & Creative Options",
    body: "Providing multiple creative concepts is a valuable bonus - it gives you choice and confidence in the direction - but it’s not always necessary. We guide you on what serves your goals best, so you’re not paying for options you won’t use.",
  },
  {
    number: "3",
    title: "Who’s Delivering the Work",
    body: "- Junior designers or generalists = lower rates, less strategic depth\n- Specialists with proven track records, deep B2B understanding, and hands-on strategic input = premium agency fees\n\nAt Rocket, we use a hand-picked team of freelance experts, each highly skilled in their field - delivering exceptional work, but without the fancy offices, large teams, and management layers that inflate agency bills.",
  },
  {
    number: "4",
    title: "Customisation vs. Proven Frameworks",
    body: "- Fully bespoke design = takes significant time and investment - and premium agencies absolutely deliver premium work here\n- Our approach? Carefully designed templates and frameworks that are built to high standards - then customised completely to your brand. The result? You get speed and value, without the meaningful drop in quality you might expect. It’s smart, efficient, and polished - built on proven foundations, not cut corners.",
  },
  {
    number: "5",
    title: "Revisions & Stakeholder Alignment",
    body: "Most proposals include a set number of review rounds. Every extra round, every significant direction change, every additional approver adds time - and time means cost. Clear alignment early on keeps things efficient, predictable, and sensible. We build in revisions to get it right - and we guide you to get aligned internally so you don’t pay for unnecessary delays.",
  },
];

const whyWeChargeLess = [
  {
    emoji: "🚀",
    title: "Lean, efficient operations",
    text: "no fancy office, no layers of management, no inflated overheads",
  },
  {
    emoji: "🤝",
    title: "Hand-picked freelance network",
    text: "trusted specialists delivering exceptional work at fair rates",
  },
  {
    emoji: "📈",
    title: "Long-term partnerships",
    text: "priced for sustainable growth together, not big one-off fees",
  },
  {
    emoji: "🎯",
    title: "Proven frameworks, fully customised",
    text: "we don’t reinvent the wheel every time, but we shape it completely around your brand",
  },
  {
    emoji: "💬",
    title: "Total transparency",
    text: "no hidden costs, no surprise add-ons, just clear pricing from day one",
  },
];
---

<Layout showCTA={false}>
  <!-- Hero Section (Slide 60) -->
  <section class="bg-brand-navy pt-20 pb-20 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto flex flex-col items-start">
      <h1 class="text-6xl sm:text-5xl md:text-6xl font-heading mb-8 font-semibold leading-[1.1] text-white">
        {hero.headingWhite}
        <br />
        <span class="text-brand-green">{hero.headingGreen}</span> {hero.emoji}
      </h1>

      <p class="hero-subtext mb-8 max-w-3xl">{hero.body}</p>

      <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-6">
        <Button href="https://meetings-eu1.hubspot.com/taz-b" variant="primary">
          Book a free clarity call
        </Button>
        <Button href="/pricing" variant="secondary">
          Pricing
        </Button>
      </div>
    </div>
  </section>

  <!-- How We're Different (Slide 61) -->
  <section class="bg-brand-navy text-white py-16 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-[34px] md:text-[40px] text-brand-green font-semibold mb-8 leading-tight">
        How we’re different... 🧐
      </h2>
      <div class="space-y-6 font-body text-lg md:text-xl text-white/90 font-light leading-relaxed">
        <p>
          Our mission is simple: Great B2B marketing shouldn’t be reserved only
          for those with a limitless budget.
        </p>
        <p>
          We’ve built our model around long-term partnerships, not one-off
          big-ticket spends. By combining an efficient, streamlined operation
          with our hand-picked network of trusted freelance specialists, we
          deliver high calibre work - at a fraction of the cost.
        </p>
        <p>
          We believe B2B lead generation and brand building are long-term
          strategies, not quick fixes.
        </p>
        <p>
          So instead of asking you to pay huge lump sums upfront, we structure
          our pricing to be affordable and sustainable - month after month, as
          you grow.
        </p>
        <p class="text-brand-green font-medium">
          Below is an honest, no-fluff breakdown of what you can expect to pay
          across the market - and how Rocket fits in.
        </p>
      </div>
    </div>
  </section>

  <!-- Quick Answer Card (Slide 62) -->
  <section class="bg-brand-navy py-16 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto">
      <div class="bg-brand-blue rounded-3xl p-6 sm:p-8 md:p-12 text-white shadow-2xl">
        <h2 class="font-heading text-2xl md:text-4xl font-bold mb-4 text-white">
          Quick Answer: UK B2B Marketing Costs at a Glance
        </h2>
        <p class="font-body text-base md:text-lg text-blue-100 mb-8 font-light">
          Market rates compared across low-end, mid-range, and premium agency
          tiers:
        </p>

        <div class="overflow-x-auto">
          <table class="w-full text-left font-body text-sm sm:text-base border-collapse min-w-[540px]">
            <thead>
              <tr class="border-b-2 border-blue-400/40 text-blue-100 font-heading">
                <th scope="col" class="py-3 pr-4 font-semibold text-white">
                  Service / Deliverable
                </th>
                <th scope="col" class="py-3 px-3 font-semibold text-white">
                  Low-end
                </th>
                <th scope="col" class="py-3 px-3 font-semibold text-white">
                  Mid-range
                </th>
                <th scope="col" class="py-3 pl-3 font-semibold text-white">
                  Premium
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-blue-500/20">
              {marketRates.map((rate) => (
                <tr class="hover:bg-blue-600/20 transition-colors">
                  <td class="py-3.5 pr-4 font-medium text-white">
                    {rate.service}
                  </td>
                  <td class="py-3.5 px-3 text-blue-100 font-light">
                    {rate.low}
                  </td>
                  <td class="py-3.5 px-3 text-blue-100 font-light">
                    {rate.mid}
                  </td>
                  <td class="py-3.5 pl-3 text-blue-100 font-light">
                    {rate.premium}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-blue-200/80 mt-3 font-light">
          *excluding ad spend
        </p>

        <div class="mt-8 pt-4 border-t border-blue-400/30">
          <a
            href="/pricing"
            class="text-white underline font-heading font-semibold hover:text-brand-green transition-colors text-base md:text-lg"
          >
            See all our services &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What Pushes Prices Up (Slides 63 & 64) -->
  <section class="bg-brand-navy text-white py-20 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-[34px] md:text-[40px] text-brand-green font-semibold mb-6 leading-tight">
        What pushes prices up?
      </h2>
      <p class="font-body text-lg md:text-xl text-white/90 font-light leading-relaxed mb-12">
        When you see such wide price differences, it’s not just about who’s
        "better" - it’s about what’s happening behind the scenes. These are the
        real factors that move the cost:
      </p>

      <div class="space-y-12">
        {priceDrivers.map((driver) => (
          <div class="bg-[#121c32] border border-gray-800/90 rounded-2xl p-8 md:p-10 shadow-xl">
            <h3 class="font-heading text-2xl md:text-3xl font-bold mb-4 text-white">
              {driver.number}. {driver.title}
            </h3>
            <div class="font-body text-base md:text-lg text-white/85 font-light leading-relaxed whitespace-pre-line space-y-4">
              {driver.body}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How We Can Charge Less (Slide 65) -->
  <section class="bg-brand-navy text-white py-20 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-[34px] md:text-[40px] text-brand-green font-semibold mb-10 leading-tight">
        How we can charge less
      </h2>

      <ul class="space-y-6">
        {whyWeChargeLess.map((item) => (
          <li class="flex items-start text-lg md:text-xl leading-relaxed text-white/90">
            <span class="mr-4 text-2xl shrink-0">{item.emoji}</span>
            <div>
              <strong class="font-bold text-white">{item.title}</strong> –{" "}
              <span class="font-light">{item.text}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA Banner Slide 66 -->
  <CTABanner
    heading="Making your growth feel easier"
    subtext="Book a discovery call — 30 minutes to work out what you need and what it’ll cost."
    buttonText="Book a free clarity call"
    buttonHref="https://meetings-eu1.hubspot.com/taz-b"
  />
</Layout>
