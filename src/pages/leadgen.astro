---
import Layout from "../layouts/Layout.astro";
import HomePillars from "../components/home/HomePillars.astro";
import HomeServices from "../components/home/HomeServices.astro";
import { leadgenData as pageData } from "../data/leadgen";
---

<Layout>
  <!-- Hero Section with Form -->
  <section class="bg-brand-navy pt-20 pb-28 px-8 border-b border-gray-800">
    <div
      class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start"
    >
      <!-- Left Column: Home-styled Hero Typography -->
      <div class="lg:col-span-7 flex flex-col items-start">
        <h1
          class="text-5xl md:text-7xl lg:text-7xl xl:text-[80px] font-heading mb-8 font-semibold leading-[1.05] text-white"
        >
          {pageData.hero.headingWhite}<br />
          <span class="text-brand-green">{pageData.hero.headingGreen}</span>
        </h1>

        <p class="hero-subtext max-w-2xl mb-8">
          {pageData.hero.body}
        </p>

        <!-- Trust bullet highlights with home-style ticks -->
        <ul
          class="space-y-3.5 text-base md:text-lg font-body text-gray-300 font-light mt-2"
        >
          {
            pageData.hero.trustPoints.map((point) => (
              <li class="flex items-center gap-3">
                <svg
                  class="w-5 h-5 text-brand-green flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4.5 12.75l6 6 9-13.5"
                  />
                </svg>
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Right Column: Premium Form Card -->
      <div class="lg:col-span-5 w-full">
        <div
          class="bg-[#121c32] border border-gray-800/90 rounded-2xl p-8 md:p-10 shadow-2xl relative"
        >
          <div class="mb-6">
            <h2
              class="text-2xl md:text-3xl font-heading font-bold text-white mb-2"
            >
              {pageData.hero.form.title}
            </h2>
            <p class="text-sm md:text-base text-gray-400 font-body font-light">
              {pageData.hero.form.subtitle}
            </p>
          </div>

          <form
            class="flex flex-col space-y-5"
            onsubmit="event.preventDefault();"
          >
            <div class="flex flex-col">
              <label
                for="name"
                class="font-body text-xs uppercase tracking-wider text-gray-300 font-semibold mb-2"
              >
                {pageData.hero.form.nameLabel}
              </label>
              <input
                type="text"
                id="name"
                placeholder={pageData.hero.form.namePlaceholder}
                class="w-full px-4 py-3.5 rounded-lg bg-brand-navy border border-gray-700 text-white font-body placeholder:text-gray-500 focus:outline-none focus:border-brand-green focus:ring-1 focus:ring-brand-green transition-all"
                required
              />
            </div>

            <div class="flex flex-col">
              <label
                for="email"
                class="font-body text-xs uppercase tracking-wider text-gray-300 font-semibold mb-2"
              >
                {pageData.hero.form.emailLabel}
              </label>
              <input
                type="email"
                id="email"
                placeholder={pageData.hero.form.emailPlaceholder}
                class="w-full px-4 py-3.5 rounded-lg bg-brand-navy border border-gray-700 text-white font-body placeholder:text-gray-500 focus:outline-none focus:border-brand-green focus:ring-1 focus:ring-brand-green transition-all"
                required
              />
            </div>

            <button
              type="submit"
              class="w-full bg-brand-green text-brand-navy py-4 px-6 rounded-lg font-heading font-bold text-lg hover:bg-white hover:shadow-lg hover:shadow-brand-green/10 transition-all duration-200 mt-2 cursor-pointer"
            >
              {pageData.hero.form.buttonText}
            </button>

            <p
              class="text-center text-xs text-gray-400 font-body font-light pt-1"
            >
              {pageData.hero.form.privacyNote}
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Pillars Section (Reusing HomePillars) -->
  <HomePillars />

  <!-- What's Inside Section formatted like page 10 / meetbob quick answer box -->
  <section class="bg-brand-navy text-white py-16 px-8 border-b border-gray-800">
    <div class="max-w-4xl mx-auto">
      <div class="bg-brand-blue rounded-2xl p-10 md:p-14 text-white shadow-2xl">
        <h2 class="font-heading text-3xl md:text-5xl font-bold mb-6 text-white">
          {pageData.whatsInside.heading}
        </h2>
        <p class="font-body text-lg md:text-xl text-blue-100 mb-10 leading-relaxed font-light">
          {pageData.whatsInside.intro}
        </p>

        <h3 class="font-heading text-2xl md:text-3xl font-semibold mb-6 text-white">
          {pageData.whatsInside.resourcesHeading}
        </h3>
        <ul class="space-y-4 font-body text-base md:text-lg">
          {
            pageData.whatsInside.resources.map((res) => (
              <li class="flex items-start">
                <svg
                  class="w-6 h-6 text-brand-green mr-3.5 flex-shrink-0 mt-[3px]"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3.5"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4.5 12.75l6 6 9-13.5"
                  />
                </svg>
                <span class="text-white/95">{res}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-10 pt-8 border-t border-blue-400/30">
          <a
            href="#details"
            class="text-white font-heading font-semibold hover:text-brand-green transition-colors underline text-base md:text-lg"
          >
            Get instant access to everything inside &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  <section class="bg-brand-navy text-white py-16 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl text-brand-green mb-12 font-bold">
        {pageData.faqs.heading}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          pageData.faqs.items.map((faq) => (
            <div class="bg-brand-green rounded-3xl p-10 text-brand-navy flex flex-col">
              <h3 class="font-heading text-2xl md:text-3xl font-bold mb-6">
                {faq.question}
              </h3>
              <p
                class="font-body text-lg leading-relaxed"
                set:html={faq.answer}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3 ways to go further (Using HomeServices) -->
  <HomeServices />
</Layout>
