---
import Layout from "../../layouts/Layout.astro";
import ServiceTemplate from "../../components/services/ServiceTemplate.astro";
import SocialSellingIncluded from "../../components/services/SocialSellingIncluded.astro";

const serviceData = {
  hero: {
    titleHtml:
      'Turn connections<br /><span class="text-brand-green">into conversations</span> 🧲',
    serviceName: "",
    description:
      "Fill your pipeline with the right people - consistently. A done-for-you LinkedIn outreach system designed to create genuine opportunities - without feeling salesy.",
    cta: [
      {
        label: "Book a free clarity call",
        href: "https://meetings-eu1.hubspot.com/taz-b",
        variant: "primary" as const,
      },
      {
        label: "Pricing",
        href: "/pricing",
        variant: "secondary" as const,
      },
    ],
  },

  needThisIf: {
    heading: "needs to be the same font style as the home page 🧐",
    points: [
      "you know who you want to talk to, but reaching out consistently doesn’t happen",
      "you’d rather close deals than write cold messages and manage inboxes",
      "LinkedIn outreach feels awkward, time-consuming or inauthentic",
      "you want predictable, sustainable growth",
      "you want a steady flow of qualified leads",
    ],
  },

  deliverables: {
    heading: "What you’ll leave with... ✅",
    items: [
      {
        title: "Your ideal client list",
        description:
          "We define your perfect audience and build your core search - delivered clean, organised, and pre-formatted for personal outreach.",
        icon: "bulb",
      },
      {
        title: "Proven messaging",
        description:
          "Time-tested, low-pressure scripts that feel like you - designed to get genuine responses from the right people.",
        icon: "chat",
      },
      {
        title: "Full launch setup",
        description:
          "Everything in place, ready to go - campaign built, systems aligned, and launched with confidence.",
        icon: "website",
      },
      {
        title: "Management & nurturing",
        description:
          "Daily care of your campaign - conversations guided, relationships built, and leads warmed over time.",
        icon: "network",
      },
    ],
  },

  ctaBanner: {
    heading: "Making your growth feel easier",
    subtext:
      "Book a discovery call — 30 minutes to work out what you need and what it’ll cost.",
    buttonText: "Book a free clarity call",
    buttonHref: "https://meetings-eu1.hubspot.com/taz-b",
  },
};

const includedData = {
  targetClarity: {
    heading: "👔 Target Clarity",
    points: [
      "We help define your Ideal Customer Profile (ICP)",
      'We help you discover your “foot in the door" proposition - your most compelling opening angle',
    ],
  },
  campaignManagement: {
    heading: "🧑‍💻 Campaign Management",
    points: [
      "Curated lead list - 5,000 targeted prospects",
      "Warm, authentic outreach messaging",
      "Daily campaign management: connection requests, follow-ups, relationship building",
      "Inbox handling and conversation nurturing",
    ],
  },
  systemsTransparency: {
    heading: "🧠 Systems & Transparency",
    points: [
      "Dedicated Notion workspace - track progress in real time",
      "We create your pitch deck presentation",
      "And your sales brochure",
      "Weekly progress updates + full performance reports",
      "Regular 1:1 strategy calls throughout",
    ],
  },
};
---

<Layout showCTA={false}>
  <ServiceTemplate
    hero={serviceData.hero}
    needThisIf={serviceData.needThisIf}
    deliverables={serviceData.deliverables}
    ctaBanner={serviceData.ctaBanner}
    howItWorks={{ heading: "", steps: [] }}
  >
    <SocialSellingIncluded slot="after-deliverables" data={includedData} />
  </ServiceTemplate>
</Layout>
