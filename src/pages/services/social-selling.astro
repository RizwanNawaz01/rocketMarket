---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <!-- Value Prop Section -->
  <section class="bg-brand-navy text-white py-24 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto flex flex-col items-start">
      <h2
        class="text-5xl md:text-7xl font-heading mb-8 leading-tight text-white max-w-5xl"
      >
        Turn connections into<br />
        conversations.<br />
        <span class="text-brand-green">And conversations into pipeline.</span>
      </h2>
      <p
        class="text-xl md:text-2xl font-body max-w-4xl mb-12 text-white leading-relaxed"
      >
        A done-for-you LinkedIn outreach system designed to create genuine
        opportunities — without feeling salesy.
      </p>
      <div
        class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-6"
      >
        <a
          href="/contact"
          class="bg-brand-green text-brand-navy px-8 py-4 rounded font-bold font-heading text-lg hover:bg-white transition-colors text-center"
        >
          Book a fit call
        </a>
        <a
          href="#details"
          class="border border-brand-green text-brand-green px-8 py-4 rounded font-bold font-heading text-lg hover:bg-brand-green hover:text-brand-navy transition-colors text-center"
        >
          View our work
        </a>
      </div>
    </div>
  </section>

  <!-- You'll probably need this if -->
  <section
    id="details"
    class="bg-brand-navy text-white py-24 px-8 border-b border-gray-800"
  >
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl text-brand-green mb-12">
        You'll probably need this if...
      </h2>
      <ul class="space-y-6 text-xl font-body max-w-5xl">
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span
            >LinkedIn outreach feels awkward, time-consuming or inauthentic</span
          >
        </li>
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span
            >you want a steady flow of qualified leads, not just random
            connection requests</span
          >
        </li>
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span
            >you know who you want to talk to - but reaching out consistently
            doesn't happen</span
          >
        </li>
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span>you want predictable, sustainable growth</span>
        </li>
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span
            >you'd rather close deals than write cold messages and manage
            inboxes</span
          >
        </li>
      </ul>
    </div>
  </section>

  <!-- What you'll leave with -->
  <section class="bg-brand-navy text-white py-24 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl text-brand-green mb-12">
        What you'll leave with
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div
          class="bg-brand-ice rounded-[2rem] p-8 text-brand-navy flex flex-col min-h-[300px]"
        >
          <h3 class="font-heading text-3xl font-bold mb-6">
            Your ideal client list
          </h3>
          <p class="font-body text-lg">
            5,000 targeted leads, built and segmented by who they are and what
            they need
          </p>
        </div>
        <div
          class="bg-brand-ice rounded-[2rem] p-8 text-brand-navy flex flex-col min-h-[300px]"
        >
          <h3 class="font-heading text-3xl font-bold mb-6">
            Proven messaging strategy
          </h3>
          <p class="font-body text-lg">
            natural, human outreach that starts real conversations, not robotic
            pitches
          </p>
        </div>
        <div
          class="bg-brand-ice rounded-[2rem] p-8 text-brand-navy flex flex-col min-h-[300px]"
        >
          <h3 class="font-heading text-3xl font-bold mb-6">
            Full launch setup
          </h3>
          <p class="font-body text-lg">
            campaigns live, monitored, and optimised week-on-week
          </p>
        </div>
        <div
          class="bg-brand-ice rounded-[2rem] p-8 text-brand-navy flex flex-col min-h-[300px]"
        >
          <h3 class="font-heading text-3xl font-bold mb-6">
            Inbox management & nurturing
          </h3>
          <p class="font-body text-lg">
            Replies handled, warm leads followed up, conversations kept moving
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section
    class="bg-brand-blue text-white py-16 px-8 border-t border-brand-navy"
  >
    <div class="flex flex-col md:flex-row items-center justify-between">
      <div class="mb-8 md:mb-0">
        <h2 class="font-heading text-4xl md:text-5xl mb-4 font-bold text-white">
          Look the part. Mean business.
        </h2>
        <p class="font-body text-xl">
          Tell us what you're working on. No pitch, no pressure.
        </p>
      </div>
      <div>
        <a
          href="/contact"
          class="bg-brand-navy text-white px-8 py-4 rounded font-bold font-heading text-lg hover:bg-brand-green hover:text-brand-navy transition-colors inline-block whitespace-nowrap"
        >
          Book a fit call
        </a>
      </div>
    </div>
  </section>
  <!-- How it works -->
  <section class="bg-brand-navy text-white py-24 px-8">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl text-brand-green mb-12">
        How it works
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-brand-blue rounded-lg p-10 flex flex-col min-h-[350px]">
          <h3 class="font-heading text-3xl font-bold mb-6">
            Data & Foundation
          </h3>
          <p class="font-body text-lg text-white">
            We define your ideal client, build your targeted list, and map out
            the messaging that resonates with them.
          </p>
        </div>
        <div class="bg-brand-blue rounded-lg p-10 flex flex-col min-h-[350px]">
          <h3 class="font-heading text-3xl font-bold mb-6">Connect & Start</h3>
          <p class="font-body text-lg text-white">
            Strategic outreach goes live — genuine connections, thoughtful
            messages, and building visibility with exactly the right people.
          </p>
        </div>
        <div class="bg-brand-blue rounded-lg p-10 flex flex-col min-h-[350px]">
          <h3 class="font-heading text-3xl font-bold mb-6">
            Nurture & Convert
          </h3>
          <p class="font-body text-lg text-white">
            We manage every reply, follow up consistently, nurture
            relationships, and turn warm interest into qualified meetings —
            handed straight to you, ready to close.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
