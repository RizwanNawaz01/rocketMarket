---
import Layout from "../../layouts/Layout.astro";
import ServiceTemplate from "../../components/services/ServiceTemplate.astro";

const serviceData = {
  hero: {
    titleHtml:
      'Be the person to follow,<br /><span class="text-brand-green">know & trust.</span>',
    serviceName: "Personal Branding",
    description:
      "A content system that explains who you are, how you help, and that you're fun to follow.",
    location: "Swansea-based. Working with teams across the UK.",
    cta: [
      {
        label: "Book a call",
        href: "https://meetings-eu1.hubspot.com/taz-b",
        variant: "primary",
      },
      {
        label: "Pricing",
        href: "/pricing",
        variant: "secondary",
      },
    ],
  },

  needThisIf: {
    heading: "You'll probably need this if...",
    points: [
      "you show up inconsistently — or not at all — and your profile feels generic",
      "people don't immediately understand why they should work with you",
      "you want to stand out as the go-to expert in your space",
      "your experience, story and values aren't visible enough to build real trust",
      "you know consistent content drives growth - but you'd rather spend your time running your business",
    ],
  },

  deliverables: {
    heading: "What you'll leave with",
    items: [
      {
        title: "Visual templates",
        description: "Branded, on-point visuals that match your identity",
      },
      {
        title: "Optimised LinkedIn profile",
        description:
          "Polished, keyword-rich, and positioned to attract the right people",
      },
      {
        title: "Core content pillars",
        description:
          "Your journey, your purpose, your positioning — so everything you say has focus",
      },
      {
        title: "Consistent content system",
        description: "3-4 posts each week, planned and ready to go",
      },
    ],
  },

  ctaBanner: {
    heading: "Look the part. Mean business.",
    subtext: "Tell us what you're working on. No pitch, no pressure.",
    buttonText: "Book a fit call",
    buttonHref: "https://meetings-eu1.hubspot.com/taz-b",
  },

  howItWorks: {
    heading: "How it works",
    steps: [
      {
        title: "Structure + journey",
        description:
          "We get clear on your story, your strengths, and exactly what makes you different — then build your brand around you.",
      },
      {
        title: "Concepts + refinement",
        description:
          "We shape your 3-pillar strategy, draft your core content themes, and refine until your voice feels right — never generic, never forced.",
      },
      {
        title: "Launch support",
        description:
          "Your profile goes live, your content starts publishing, and you show up consistently — building visibility, authority, and audience that genuinely cares.",
      },
    ],
  },

  faqs: {
    heading: "FAQs",
    items: [
      {
        question: "How much time will I need to commit each week?",
        answer:
          "Around <strong>30–45 minutes every couple of weeks</strong> for a quick briefing call. We handle all research, writing, hooks, formatting, and scheduling so you can stay focused on running your business.",
      },
      {
        question: "Will the content sound like me?",
        answer:
          "Yes, 100%. We run an initial deep-dive interview to capture your <strong>voice, opinions, story, and perspective</strong>. Nothing goes live without your sign-off.",
      },
      {
        question: "How long before we see traction?",
        answer:
          "Most clients see meaningful increases in <strong>profile views, connection acceptances, and direct inbound messages within the first 30–60 days</strong> of consistent posting.",
      },
    ],
  },
};
---

<Layout>
  <ServiceTemplate {...serviceData} />
</Layout>
