---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <!-- Value Prop Section -->
  <section class="bg-brand-navy text-white py-24 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto flex flex-col items-start">
      <h2
        class="text-5xl md:text-7xl font-heading mb-8 leading-tight text-brand-green max-w-4xl"
      >
        Be the person to follow,<br />
        know & trust.
      </h2>
      <p
        class="text-xl md:text-2xl font-body max-w-4xl mb-12 text-white leading-relaxed"
      >
        A content system that explains who you are, how you help, and that
        you're fun to follow.
      </p>
      <div
        class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-6"
      >
        <a
          href="/contact"
          class="bg-brand-green text-brand-navy px-8 py-4 rounded font-bold font-heading text-lg hover:bg-white transition-colors text-center"
        >
          Book a fit call
        </a>
        <a
          href="#details"
          class="border border-brand-green text-brand-green px-8 py-4 rounded font-bold font-heading text-lg hover:bg-brand-green hover:text-brand-navy transition-colors text-center"
        >
          View our work
        </a>
      </div>
    </div>
  </section>

  <!-- You'll probably need this if -->
  <section
    id="details"
    class="bg-brand-navy text-white py-24 px-8 border-b border-gray-800"
  >
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl text-brand-green mb-12">
        You'll probably need this if...
      </h2>
      <ul class="space-y-6 text-xl font-body max-w-5xl">
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span
            >you show up inconsistently — or not at all — and your profile feels
            generic</span
          >
        </li>
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span
            >people don't immediately understand why they should work with you</span
          >
        </li>
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span>you want to stand out as the go-to expert in your space</span>
        </li>
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span
            >your experience, story and values aren't visible enough to build
            real trust</span
          >
        </li>
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span
            >you know consistent content drives growth - but you'd rather spend
            your time running your business</span
          >
        </li>
      </ul>
    </div>
  </section>

  <!-- What you'll leave with -->
  <section class="bg-brand-navy text-white py-24 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl text-brand-green mb-12">
        What you'll leave with
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div
          class="bg-brand-ice rounded-[2rem] p-8 text-brand-navy flex flex-col min-h-[300px]"
        >
          <h3 class="font-heading text-3xl font-bold mb-6">Visual templates</h3>
          <p class="font-body text-lg">
            Branded, on-point visuals that match your identity
          </p>
        </div>
        <div
          class="bg-brand-ice rounded-[2rem] p-8 text-brand-navy flex flex-col min-h-[300px]"
        >
          <h3 class="font-heading text-3xl font-bold mb-6">
            Optimised LinkedIn profile
          </h3>
          <p class="font-body text-lg">
            Polished, keyword-rich, and positioned to attract the right people
          </p>
        </div>
        <div
          class="bg-brand-ice rounded-[2rem] p-8 text-brand-navy flex flex-col min-h-[300px]"
        >
          <h3 class="font-heading text-3xl font-bold mb-6">
            Core content pillars
          </h3>
          <p class="font-body text-lg">
            Your journey, your purpose, your positioning — so everything you say
            has focus
          </p>
        </div>
        <div
          class="bg-brand-ice rounded-[2rem] p-8 text-brand-navy flex flex-col min-h-[300px]"
        >
          <h3 class="font-heading text-3xl font-bold mb-6">
            Consistent content system
          </h3>
          <p class="font-body text-lg">
            3-4 posts each week, planned and ready to go
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section
    class="bg-brand-blue text-white py-16 px-8 border-t border-brand-navy"
  >
    <div class="flex flex-col md:flex-row items-center justify-between">
      <div class="mb-8 md:mb-0">
        <h2 class="font-heading text-4xl md:text-5xl mb-4 font-bold text-white">
          Look the part. Mean business.
        </h2>
        <p class="font-body text-xl">
          Tell us what you're working on. No pitch, no pressure.
        </p>
      </div>
      <div>
        <a
          href="/contact"
          class="bg-brand-navy text-white px-8 py-4 rounded font-bold font-heading text-lg hover:bg-brand-green hover:text-brand-navy transition-colors inline-block whitespace-nowrap"
        >
          Book a fit call
        </a>
      </div>
    </div>
  </section>
  <!-- How it works -->
  <section class="bg-brand-navy text-white py-24 px-8">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl text-brand-green mb-12">
        How it works
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-brand-blue rounded-lg p-10 flex flex-col min-h-[350px]">
          <h3 class="font-heading text-3xl font-bold mb-6">
            Structure + journey
          </h3>
          <p class="font-body text-lg text-white">
            We get clear on your story, your strengths, and exactly what makes
            you different — then build your brand around you.
          </p>
        </div>
        <div class="bg-brand-blue rounded-lg p-10 flex flex-col min-h-[350px]">
          <h3 class="font-heading text-3xl font-bold mb-6">
            Concepts + refinement
          </h3>
          <p class="font-body text-lg text-white">
            We shape your 3-pillar strategy, draft your core content themes, and
            refine until your voice feels right — never generic, never forced.
          </p>
        </div>
        <div class="bg-brand-blue rounded-lg p-10 flex flex-col min-h-[350px]">
          <h3 class="font-heading text-3xl font-bold mb-6">Launch support</h3>
          <p class="font-body text-lg text-white">
            Your profile goes live, your content starts publishing, and you show
            up consistently — building visibility, authority, and audience that
            genuinely cares.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
