---
import Layout from "../../layouts/Layout.astro";
import ServiceTemplate from "../../components/services/ServiceTemplate.astro";
import PersonalBrandingIncluded from "../../components/services/PersonalBrandingIncluded.astro";

const serviceData = {
  hero: {
    titleHtml:
      'Be the person to<br /><span class="text-brand-green">follow, know & trust</span> 💚',
    serviceName: "Personal Branding",
    description:
      "Build authority that attracts opportunities to you, with a content system that explains who you are, how you help, and that you’re fun to follow.",
    cta: [
      {
        label: "Book a fit call",
        href: "https://meetings-eu1.hubspot.com/taz-b",
        variant: "primary" as const,
      },
      {
        label: "View our work",
        href: "/case-study",
        variant: "secondary" as const,
      },
    ],
  },

  needThisIf: {
    heading: "You’ll probably need this if... 🧐",
    points: [
      "people don’t immediately understand why they should work with you",
      "you want to stand out as the go-to expert in your space",
      "your experience, story, and values aren’t visible enough to build real trust",
      "you show up inconsistently - or not at all - and your profile feels generic",
      "you know consistent content drives growth - but you’d rather spend your time running your business",
    ],
  },

  deliverables: {
    heading: "What you’ll leave with... ✅",
    items: [
      {
        title: "Transparently organised",
        description:
          "Central brand hub: your positioning, narrative, content calendar - all strategically organised into one place.",
        icon: "network",
      },
      {
        title: "Profile transformation",
        description:
          "We help you clarify what you stand for and how the brand should come across, including your core message and tone of voice.",
         icon: "website",
      },
      {
        title: "Consistent content system",
        description:
          "Every post builds trust and clarity. We cover your identity, your purpose, your proven method — and keep it all human, warm, and fun to read.",
         icon: "speaker",
      },
      {
        title: "Visual brand direction & assets",
        description:
          "More than just a facelift: a cohesive visual identity that signals professionalism, builds recognition, and feels consistent everywhere you appear.",
        icon: "bulb",
      },
    ],
  },

  ctaBanner: {
    heading: "Making your growth feel easier",
    subtext:
      "Book a discovery call — 30 minutes to work out what you need and what it’ll cost.",
    buttonText: "Book a fit call",
    buttonHref: "https://meetings-eu1.hubspot.com/taz-b",
  },
};

const includedData = {
  notion: {
    heading: "🧠 Your Notion Operating System",
    points: [
      "Central brand hub: positioning, narrative, content calendar - all in one place",
      "Fully transparent: you see exactly what’s planned and why",
      "Collaborative creation: we build it together, so it always sounds like you",
      "Regular 1-1 meetings",
    ],
  },
  visual: {
    heading: "🎨 Visual Brand Direction & Assets",
    points: [
      "Brand guidelines: tone, style, colours, fonts",
      "LinkedIn banner + featured section imagery",
      "Carousel templates and content pillar-specific visuals",
      "E-book, presentation slide deck, and brochure templates",
      "Plus more!",
    ],
  },
  transformation: {
    heading: "🙂 Profile transformation",
    clarityPoints: [
      "Your story & mission",
      "The problem you solve",
      "Your methodology",
      "Your results",
      "Who you best serve",
      "Clear next steps to work with you",
    ],
  },
  content: {
    heading: "✍ Content That Feels Like You",
    points: [
      "Personality questionnaire - to ensure authenticity",
      "Up to 10 rewrites",
      "We write 4 x posts a week",
    ],
    pillars: [
      "Your story - why you do what you do",
      "The problem - the pain points your audience faces",
      "Your solution - exactly how you help",
      "Understanding your customer - showing you truly \"get\" them",
      "Polls & engagement - building interaction and market insight",
      "Social proof - testimonials and case studies",
      "Behind the scenes - we encourage you to get ‘out of the office’ and do fun things/ meet people - so we can shout out about it and tag your new connections",
      "Industry news - commentary on the latest industry news to build authority",
    ],
  },
};
---

<Layout showCTA={false}>
  <ServiceTemplate
    hero={serviceData.hero}
    needThisIf={serviceData.needThisIf}
    deliverables={serviceData.deliverables}
    ctaBanner={serviceData.ctaBanner}
    howItWorks={{ heading: "", steps: [] }}
  >
    <PersonalBrandingIncluded slot="after-deliverables" data={includedData} />
  </ServiceTemplate>
</Layout>
