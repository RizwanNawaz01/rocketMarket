---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <!-- Value Prop Section -->
  <section class="bg-brand-navy text-white py-24 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto flex flex-col items-start">
      <h2
        class="text-5xl md:text-7xl font-heading mb-8 leading-tight text-brand-green max-w-4xl"
      >
        Look the part.<br />
        Mean business.
      </h2>
      <p
        class="text-xl md:text-2xl font-body max-w-3xl mb-12 text-white leading-relaxed"
      >
        A complete brand and web identity that makes you look credible,
        consistent, and worth what you charge.
      </p>
      <div
        class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-6"
      >
        <a
          href="/contact"
          class="bg-brand-green text-brand-navy px-8 py-4 rounded font-bold font-heading text-lg hover:bg-white transition-colors text-center"
        >
          Book a fit call
        </a>
        <a
          href="#details"
          class="border border-brand-green text-brand-green px-8 py-4 rounded font-bold font-heading text-lg hover:bg-brand-green hover:text-brand-navy transition-colors text-center"
        >
          View our work
        </a>
      </div>
    </div>
  </section>

  <!-- You'll probably need this if -->
  <section
    id="details"
    class="bg-brand-navy text-white py-24 px-8 border-b border-gray-800"
  >
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl text-brand-green mb-12">
        You'll probably need this if...
      </h2>
      <ul class="space-y-6 text-xl font-body max-w-4xl">
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span
            >your branding looks different across the website, socials and PDFs</span
          >
        </li>
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span>you've outgrown the DIY look</span>
        </li>
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span>you want to charge more - but the brand is undermining you</span
          >
        </li>
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span>your website looks dated and it's costing you trust</span>
        </li>
        <li class="flex items-start">
          <svg
            class="w-8 h-8 text-white mr-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span>your message isn't clear until someone speaks to you</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- What you'll leave with -->
  <section class="bg-brand-navy text-white py-24 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl text-brand-green mb-12">
        What you'll leave with
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div
          class="bg-brand-ice rounded-[2rem] p-8 text-brand-navy flex flex-col min-h-[300px]"
        >
          <h3 class="font-heading text-3xl font-bold mb-6">A refined logo</h3>
          <p class="font-body text-lg">Plus variations you can actually use.</p>
        </div>
        <div
          class="bg-brand-ice rounded-[2rem] p-8 text-brand-navy flex flex-col min-h-[300px]"
        >
          <h3 class="font-heading text-3xl font-bold mb-6">
            Colour + type system
          </h3>
          <p class="font-body text-lg">
            A clear, flexible style you can apply everywhere.
          </p>
        </div>
        <div
          class="bg-brand-ice rounded-[2rem] p-8 text-brand-navy flex flex-col min-h-[300px]"
        >
          <h3 class="font-heading text-3xl font-bold mb-6">
            Basic SEO foundations
          </h3>
          <p class="font-body text-lg">
            Titles, structure, crawlability — so you're findable from launch
          </p>
        </div>
        <div
          class="bg-brand-ice rounded-[2rem] p-8 text-brand-navy flex flex-col min-h-[300px]"
        >
          <h3 class="font-heading text-3xl font-bold mb-6">Web Launch</h3>
          <p class="font-body text-lg">
            Mobile, forms, key pages, redirects — so nothing breaks when you go
            live
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section
    class="bg-brand-blue text-white py-16 px-8 border-t border-brand-navy"
  >
    <div class="flex flex-col md:flex-row items-center justify-between">
      <div class="mb-8 md:mb-0">
        <h2 class="font-heading text-4xl md:text-5xl mb-4 font-bold text-white">
          Look the part. Mean business.
        </h2>
        <p class="font-body text-xl">
          Tell us what you're working on. No pitch, no pressure.
        </p>
      </div>
      <div>
        <a
          href="/contact"
          class="bg-brand-navy text-white px-8 py-4 rounded font-bold font-heading text-lg hover:bg-brand-green hover:text-brand-navy transition-colors inline-block whitespace-nowrap"
        >
          Book a fit call
        </a>
      </div>
    </div>
  </section>
  <!-- How it works -->
  <section class="bg-brand-navy text-white py-24 px-8">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl text-brand-green mb-12">
        How it works
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-brand-blue rounded-lg p-10 flex flex-col min-h-[350px]">
          <h3 class="font-heading text-3xl font-bold mb-6">
            Structure + journey
          </h3>
          <p class="font-body text-lg text-white">
            We plan every page around what your visitors need to see, and what
            you need them to do.
          </p>
        </div>
        <div class="bg-brand-blue rounded-lg p-10 flex flex-col min-h-[350px]">
          <h3 class="font-heading text-3xl font-bold mb-6">
            Concepts + refinement
          </h3>
          <p class="font-body text-lg text-white">
            We develop 2–3 directions, present them in context, then refine the
            strongest into your final identity.
          </p>
        </div>
        <div class="bg-brand-blue rounded-lg p-10 flex flex-col min-h-[350px]">
          <h3 class="font-heading text-3xl font-bold mb-6">Launch support</h3>
          <p class="font-body text-lg text-white">
            You get a live, tested site, WordPress training, and everything
            handed over cleanly.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
