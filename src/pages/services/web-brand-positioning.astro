---
import Layout from "../../layouts/Layout.astro";
import ServiceTemplate from "../../components/services/ServiceTemplate.astro";

const serviceData = {
  hero: {
    titleHtml:
      'Look the part.<br /><span class="text-brand-green">Mean business.</span>',
    serviceName: "Web and Brand Positioning",
    description:
      "A complete brand and web identity that makes you look credible, consistent, and worth what you charge.",
    location: "Swansea-based. Working with teams across the UK.",
    cta: [
      {
        label: "Book a call",
        href: "https://meetings-eu1.hubspot.com/taz-b",
        variant: "primary",
      },
      {
        label: "Pricing",
        href: "/pricing",
        variant: "secondary",
      },
    ],
  },

  needThisIf: {
    heading: "You'll probably need this if...",
    points: [
      "your branding looks different across the website, socials and PDFs",
      "you've outgrown the DIY look",
      "you want to charge more - but the brand is undermining you",
      "your website looks dated and it's costing you trust",
      "your message isn't clear until someone speaks to you",
    ],
  },

  deliverables: {
    heading: "What you'll leave with",
    items: [
      {
        title: "A refined logo",
        description: "Plus variations you can actually use.",
      },
      {
        title: "Colour + type system",
        description: "A clear, flexible style you can apply everywhere.",
      },
      {
        title: "Basic SEO foundations",
        description:
          "Titles, structure, crawlability — so you're findable from launch",
      },
      {
        title: "Web Launch",
        description:
          "Mobile, forms, key pages, redirects — so nothing breaks when you go live",
      },
    ],
  },

  ctaBanner: {
    heading: "Look the part. Mean business.",
    subtext: "Tell us what you're working on. No pitch, no pressure.",
    buttonText: "Book a fit call",
    buttonHref: "https://meetings-eu1.hubspot.com/taz-b",
  },

  howItWorks: {
    heading: "How it works",
    steps: [
      {
        title: "Structure + journey",
        description:
          "We plan every page around what your visitors need to see, and what you need them to do.",
      },
      {
        title: "Concepts + refinement",
        description:
          "We develop 2–3 directions, present them in context, then refine the strongest into your final identity.",
      },
      {
        title: "Launch support",
        description:
          "You get a live, tested site, WordPress training, and everything handed over cleanly.",
      },
    ],
  },

  faqs: {
    heading: "FAQs",
    items: [
      {
        question: "What's in the Web and Brand Positioning package?",
        answer:
          "The pack includes a <strong>refined logo suite</strong>, <strong>colour + type system</strong>, <strong>easy-to-follow guidelines</strong>, and <strong>core brand assets</strong>. You'll get a complete visual identity and website designed for real-world use, not just a logo.",
      },
      {
        question: "How long does the process take?",
        answer:
          "It depends on scope, but most Brand & Web projects take <strong>around 3–6 weeks from kickoff to final handover</strong>. If you've already got clarity on your message and what you want to achieve, we can often move faster.",
      },
      {
        question: "What files will we receive?",
        answer:
          "You'll receive <strong>production-ready files in the right formats for print and digital</strong>, plus a tidy handover and guidelines so your team (and suppliers) can apply everything consistently going forward.",
      },
    ],
  },
