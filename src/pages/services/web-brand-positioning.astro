---
import Layout from "../../layouts/Layout.astro";
import ServiceTemplate from "../../components/services/ServiceTemplate.astro";
import WebBrandSolutions from "../../components/services/WebBrandSolutions.astro";
import CtaBanner from "../../components/CTABanner.astro";

const serviceData = {
  hero: {
    titleHtml:
      'Look the part.<br /><span class="text-brand-green">Mean business</span> 💪',
    serviceName: "Web and Brand Positioning",
    description:
      "Already worked on your personal brand with me? Your website uses the same narrative, tone, and visual guidelines we’ve already started to build. No starting over - just extending your brand across your new home on the web.",
    cta: [
      {
        label: "Book a free clarity call",
        href: "https://meetings-eu1.hubspot.com/taz-b",
        variant: "primary" as const,
      },
      {
        label: "Pricing",
        href: "/pricing",
        variant: "secondary" as const,
      },
    ],
  },

  needThisIf: {
    heading: "You’ll probably need this if... 🧐",
    points: [
      "you want to charge more - but the brand is undermining you",
      "your website looks dated, and it’s costing you trust",
      "your message isn’t crystal clear",
      "Visitors struggle to understand your offer",
      "You need a clearer identity and messaging",
    ],
  },

  deliverables: {
    heading: "What you’ll leave with...",
    items: [
      {
        title: "A brand new website",
        description:
          "Professionally built, fully branded, and ready to represent you.",
        icon: "website",
      },
      {
        title: "Logo, colour +<br />brand guidelines",
        description:
          "A cohesive visual identity that feels intentional and consistent everywhere.",
        icon: "bulb",
      },
      {
        title: "Positioning and messaging",
        description:
          "We help you clarify what you stand for and how the brand should come across, including your core message and tone of voice.",
        icon: "chat",
      },
      {
        title: "Monthly care plan",
        description:
          "We keep your site secure and up to date for new content, such as case studies or news, as it becomes available.",
        icon: "network",
      },
    ],
  },

  faqs: {
    heading: "FAQs",
    items: [
      {
        question: "Do I need to write the copy myself?",
        answer:
          " It depends which option you go for... For the template build, the messaging is included in the price. For the bespoke build, if you want us to do the messaging it will cost extra ",
      },
      {
        question: "Is there a fixed number of pages?",
        answer:
          "Option 1 - Yes - the pages are roughly fixed to our core recommended size.<br /><br />Option 2 - No - this option gives you far greater flexibility.",
      },
      {
        question: "What happens after the launch?",
        answer:
          "An affordable retainer keeps your site secure and up to date for new content, such as case studies or news, as it becomes available.",
      },
      {
        question: "Can we keep our current branding?",
        answer:
          "Yes that’s certainly an option - we can also suggest an alternative brand direction too.",
      },
      {
        question: "Can we add messaging later?",
        answer:
          "Yes we work on your core identity by default, and messaging is an additional recommendation.",
      },
      {
        question: "How many design revisions?",
        answer: "You get unlimited revisions until you are satisfied.",
      },
    ],
  },
};

const solutionsData = {
  problemHeading: "The problem... ❌",
  problemText:
    "You’ve got a great profile. People are engaging. Then they click your website… and it doesn’t match. Outdated, generic, or just not saying the right things. You know you need something better - but £10k+ for a full custom build just isn’t right yet.",
  solutionHeading: "The solution... ✅",
  options: [
    {
      title: "Option 1: Template Build",
      description:
        "We take a proven structure and system and customise them around your brand, including:",
      features: [
        "A custom logo design",
        "New brand colours, fonts, and visual style",
        "Full copy written for your brand identity and narrative (taken from your personal branding profile)",
        "4–8 core pages: Home - About - Services - Case Studies - Pricing - Contact",
        "Mobile-optimised, fast-loading, ready to grow",
        "Connected seamlessly to your LinkedIn profile voice",
      ],
      outcome:
        "A completely unique website built exactly to your vision, with every detail aligned to your brand.",
    },
    {
      title: "Option 2 - Bespoke Build 🎨",
      description:
        "Your vision, brought to life. You come with specific ideas, features, or a unique structure in mind. And I work with my build partner to create it.",
      features: [
        "Clear project management and communication",
        "Full copywriting and messaging alignment",
        "Brand consistency across every page",
        "One point of contact: me",
      ],
      outcome: "",
    },
  ],
  pricingHeading: "Web and branding pricing guide 💰",
  pricingRows: [
    {
      option: "Option 1: Template Build",
      investment: "From £1,500",
      timeline: "2–3 weeks",
      retainer: "Included",
      bestFor: "Fast launch, consistent brand, proven structure",
    },
    {
      option: "Option 2: Bespoke Build",
      investment: "From £3,000 - £4,000",
      timeline: "4–6 weeks",
      retainer: "Included",
      bestFor: "Unique requirements, custom features, specific vision",
    },
  ],
};

const cta = {
  heading: "Making your growth feel easier",
  subtext:
    "Book a discovery call — 30 minutes to work out what you need and what it’ll cost.",
  buttonText: "Book a clarity call",
  buttonHref: "https://meetings-eu1.hubspot.com/taz-b",
};
---

<Layout showCTA={false}>
  <ServiceTemplate
    hero={serviceData.hero}
    needThisIf={serviceData.needThisIf}
    deliverables={serviceData.deliverables}
    faqs={serviceData.faqs}
    howItWorks={{ heading: "", steps: [] }}
  >
    <WebBrandSolutions slot="after-deliverables" {...solutionsData} />
  </ServiceTemplate>

  <CtaBanner
    heading={cta.heading}
    subtext={cta.subtext}
    buttonText={cta.buttonText}
    buttonHref={cta.buttonHref}
  />
</Layout>
