          <div class="bg-gray-800 h-64 w-full mb-6 rounded overflow-hidden">
            <div class="w-full h-full bg-gray-700 group-hover:scale-105 transition-transform duration-500"></div>
          </div>
          <h3 class="font-heading text-2xl font-bold mb-2 group-hover:text-brand-green transition-colors">Client name</h3>
          <p class="font-body text-gray-400 mb-4">Industry</p>
          <p class="font-body text-gray-300">A website that becomes the foundation for your brand positioning.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-brand-blue text-white py-16 px-8">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between">
      <div class="mb-8 md:mb-0">
        <h2 class="font-heading text-4xl md:text-5xl mb-4 font-bold">Want results like these?</h2>
        <p class="font-body text-xl">Book a discovery call — 30 minutes to work out what you need and what it'll cost.</p>
      </div>
      <div>
        <a href="/contact" class="bg-brand-navy text-white px-8 py-4 rounded font-bold font-heading text-lg hover:bg-brand-green hover:text-brand-navy transition-colors inline-block whitespace-nowrap">
          Book a fit call
        </a>
      </div>
    </div>
  </section>
</Layout>
