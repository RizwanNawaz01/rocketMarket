---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Hero Section -->
  <section class="bg-brand-navy text-white pt-32 pb-24 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto flex flex-col items-start">
      <h1 class="text-5xl md:text-7xl font-heading mb-8 leading-tight text-brand-green">
        Selected case studies
      </h1>
      
      <p class="text-xl md:text-2xl font-body max-w-3xl mb-12 text-white leading-relaxed">
        Learn how growing companies transformed their<br/>
        challenges into extraordinary success.
      </p>

      <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-6">
        <a href="/contact" class="bg-brand-green text-brand-navy px-8 py-4 rounded font-bold font-heading text-lg hover:bg-white transition-colors text-center">
          Book a fit call
        </a>
        <a href="#case-studies" class="border border-brand-green text-brand-green px-8 py-4 rounded font-bold font-heading text-lg hover:bg-brand-green hover:text-brand-navy transition-colors text-center">
          View our work
        </a>
      </div>
    </div>
  </section>

  <!-- Grid Section -->
  <section id="case-studies" class="bg-brand-navy text-white py-24 px-8">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl mb-12">Browse our case studies</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
        <!-- Card 1 (Link to specific case study) -->
        <a href="/case-study/tomkinson" class="block group">
          <div class="bg-gray-800 h-64 w-full mb-6 rounded overflow-hidden">
            <!-- Image placeholder -->
            <div class="w-full h-full bg-gray-700 group-hover:scale-105 transition-transform duration-500"></div>
          </div>
          <h3 class="font-heading text-2xl font-bold mb-2 group-hover:text-brand-green transition-colors">Tomkinson Carpets</h3>
          <p class="font-body text-gray-400 mb-4">Retail</p>
          <p class="font-body text-gray-300">A website that becomes the foundation for your brand positioning.</p>
        </a>

        <!-- Card 2 -->
        <a href="/case-study/tomkinson" class="block group">
          <div class="bg-gray-800 h-64 w-full mb-6 rounded overflow-hidden">
            <div class="w-full h-full bg-gray-700 group-hover:scale-105 transition-transform duration-500"></div>
          </div>
          <h3 class="font-heading text-2xl font-bold mb-2 group-hover:text-brand-green transition-colors">Client name</h3>
          <p class="font-body text-gray-400 mb-4">Industry</p>
          <p class="font-body text-gray-300">A website that becomes the foundation for your brand positioning.</p>
        </a>

        <!-- Card 3 -->
        <a href="/case-study/tomkinson" class="block group">
          <div class="bg-gray-800 h-64 w-full mb-6 rounded overflow-hidden">
            <div class="w-full h-full bg-gray-700 group-hover:scale-105 transition-transform duration-500"></div>
          </div>
          <h3 class="font-heading text-2xl font-bold mb-2 group-hover:text-brand-green transition-colors">Client name</h3>
          <p class="font-body text-gray-400 mb-4">Industry</p>
          <p class="font-body text-gray-300">A website that becomes the foundation for your brand positioning.</p>
        </a>

        <!-- Card 4 -->
        <a href="/case-study/tomkinson" class="block group">
          <div class="bg-gray-800 h-64 w-full mb-6 rounded overflow-hidden">
            <div class="w-full h-full bg-gray-700 group-hover:scale-105 transition-transform duration-500"></div>
          </div>
          <h3 class="font-heading text-2xl font-bold mb-2 group-hover:text-brand-green transition-colors">Client name</h3>
          <p class="font-body text-gray-400 mb-4">Industry</p>
          <p class="font-body text-gray-300">A website that becomes the foundation for your brand positioning.</p>
        </a>

        <!-- Card 5 -->
        <a href="/case-study/tomkinson" class="block group">
          <div class="bg-gray-800 h-64 w-full mb-6 rounded overflow-hidden">
            <div class="w-full h-full bg-gray-700 group-hover:scale-105 transition-transform duration-500"></div>
          </div>
          <h3 class="font-heading text-2xl font-bold mb-2 group-hover:text-brand-green transition-colors">Client name</h3>
          <p class="font-body text-gray-400 mb-4">Industry</p>
          <p class="font-body text-gray-300">A website that becomes the foundation for your brand positioning.</p>
        </a>

        <!-- Card 6 -->
