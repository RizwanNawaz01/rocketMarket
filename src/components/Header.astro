---
import { Image } from "astro:assets";
import logoImg from "../assets/general/logo-1.png";

const pathname = Astro.url.pathname;
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const navItems = [
  { label: "Home", href: "/" },
  {
    label: "Services",
    href: "/services",
    children: [
      {
        label: "Web & Brand Positioning",
        href: "/services/web-brand-positioning",
      },
      { label: "Personal Branding", href: "/services/personal-branding" },
      { label: "Social Selling", href: "/services/social-selling" },
    ],
  },
  { label: "Pricing", href: "/pricing" },
  { label: "Case Studies", href: "/case-study" },
  { label: "Lead Gen", href: "/leadgen" },
];
---

<header
  class="w-full bg-brand-navy py-6 px-8 xl:px-18 flex items-center justify-between top-0 z-[110]"
>
  <!-- Logo -->
  <a href="/" class="flex items-center">
    <Image
      src={logoImg}
      alt="Rocket Marketing"
      class="h-10 lg:h-32 w-auto"
      loading="eager"
    />
  </a>

  <!-- Right side: Contact + Button + Hamburger -->
  <div class="flex items-center space-x-6 lg:space-x-8">
    <!-- Contact Info (hidden on small screens) -->
    <div
      class="hidden lg:flex items-center space-x-6 text-white font-body text-base font-normal tracking-[-0.2px]"
    >
      <a href="tel:07592999711" class="hover:text-brand-green transition-colors"
        >07592999711</a
      >
      <a
        href="mailto:taz@hellorocket.co.uk"
        class="hover:text-brand-green transition-colors"
        >taz@hellorocket.co.uk</a
      >
    </div>

    <!-- CTA Button -->
    <a
      href="https://meetings-eu1.hubspot.com/taz-b"
      class="hidden sm:inline-block bg-brand-green text-brand-navy px-6 py-3 rounded font-bold font-body hover:bg-white transition-colors"
    >
      Talk to Taz
    </a>

    <!-- Menu Toggle Button -->
    <button
      id="menu-toggle"
      class="text-white hover:text-brand-green transition-colors focus:outline-none relative w-8 h-8"
      aria-label="Toggle menu"
    >
      <!-- Hamburger Icon -->
      <svg
        id="icon-menu"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-8 h-8 absolute inset-0 transition-opacity duration-300"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
      </svg>
      <!-- Close Icon -->
      <svg
        id="icon-close"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-8 h-8 absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Fullscreen Menu Overlay -->
<div
  id="menu-overlay"
  class="fixed inset-0 bg-brand-navy/95 backdrop-blur-sm z-[100] opacity-0 pointer-events-none transition-opacity duration-500 flex flex-col"
>
  <div
    class="flex-grow flex flex-col justify-center px-10 sm:px-16 lg:px-28 xl:px-72 pt-20"
  >
    <nav
      class="flex flex-col items-start space-y-4 lg:space-y-6 font-heading text-4xl lg:text-5xl xl:text-6xl"
    >
      {
        navItems.map((item, index) => {
          const itemHref =
            item.href === "/"
              ? "/"
              : item.href.endsWith("/")
                ? item.href.slice(0, -1)
                : item.href;
          const isActive =
            currentPath === itemHref ||
            (itemHref !== "/" && currentPath.startsWith(itemHref));

          if (item.children) {
            return (
              <div
                class="menu-item w-full"
                style={`--delay: ${index * 75 + 100}ms`}
              >
                {/* Services toggle button */}
                <button
                  class={`services-toggle flex items-center leading-none hover:text-brand-green transition-colors ${isActive ? "text-brand-green" : "text-white"}`}
                  aria-expanded="false"
                >
                  {item.label}
                </button>
                {/* Submenu */}
                <ul class="services-submenu overflow-hidden max-h-0 transition-all duration-400 ease-in-out flex flex-col gap-3 pl-2 mt-0">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="font-heading text-2xl lg:text-3xl xl:text-4xl text-white/70 hover:text-brand-green transition-colors leading-none"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          }

          return (
            <a
              href={item.href}
              class={`menu-item leading-none hover:text-brand-green ${isActive ? "text-brand-green" : "text-white"}`}
              style={`--delay: ${index * 75 + 100}ms`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <div
      class="menu-item mt-10 lg:mt-12 flex flex-col items-start space-y-2 text-white"
      style={`--delay: ${navItems.length * 75 + 100}ms`}
    >
      <h3 class="font-heading text-2xl lg:text-3xl font-bold text-white mb-1">
        Say hello to Taz
      </h3>
      <div
        class="flex flex-wrap items-center gap-x-2 gap-y-1 font-body text-sm sm:text-base font-semibold"
      >
        <a
          href="tel:07592999711"
          class="hover:text-brand-green transition-colors"
        >
          07592999711
        </a>
        <span class="text-white/60">|</span>
        <a
          href="mailto:taz@hellorocket.co.uk"
          class="hover:text-brand-green transition-colors"
        >
          taz@hellorocket.co.uk
        </a>
      </div>
      <a
        href="https://meetings-eu1.hubspot.com/taz-b"
        class="inline-block sm:hidden bg-brand-green text-brand-navy px-6 py-2.5 rounded font-bold hover:bg-white transition-colors mt-3 text-sm"
      >
        Talk to Taz
      </a>
    </div>
  </div>
</div>

<style>
  /* Staggered fade-in up animation for menu items */
  .menu-item {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.5s ease-out,
      transform 0.5s ease-out,
      color 0.3s ease;
  }

  /* When the overlay has the 'open' class, trigger the animation on items with their respective delays */
  #menu-overlay.open .menu-item {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--delay, 0ms);
  }

  /* Submenu open state */
  .services-submenu.open {
    max-height: 300px;
    margin-top: 1rem;
    padding-top: 0.25rem;
  }

  .services-chevron.rotated {
    transform: rotate(180deg);
  }
</style>

<script>
  const menuToggleBtn = document.getElementById("menu-toggle");
  const menuOverlay = document.getElementById("menu-overlay");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");

  let isMenuOpen = false;

  if (menuToggleBtn && menuOverlay && iconMenu && iconClose) {
    menuToggleBtn.addEventListener("click", () => {
      isMenuOpen = !isMenuOpen;

      if (isMenuOpen) {
        menuOverlay.classList.remove("opacity-0", "pointer-events-none");
        menuOverlay.classList.add("open");
        document.body.style.overflow = "hidden";
        iconMenu.classList.add("opacity-0", "pointer-events-none");
        iconClose.classList.remove("opacity-0", "pointer-events-none");
      } else {
        menuOverlay.classList.remove("open");
        menuOverlay.classList.add("opacity-0", "pointer-events-none");
        document.body.style.overflow = "";
        iconClose.classList.add("opacity-0", "pointer-events-none");
        iconMenu.classList.remove("opacity-0", "pointer-events-none");
        // Also close submenu when closing the overlay
        submenu?.classList.remove("open");
        chevron?.classList.remove("rotated");
        toggle?.setAttribute("aria-expanded", "false");
      }
    });
  }

  // Services submenu toggle
  const toggle = document.querySelector<HTMLButtonElement>(".services-toggle");
  const submenu = document.querySelector<HTMLElement>(".services-submenu");
  const chevron = document.querySelector<SVGElement>(".services-chevron");

  toggle?.addEventListener("click", () => {
    const isOpen = submenu?.classList.contains("open");
    if (isOpen) {
      submenu?.classList.remove("open");
      chevron?.classList.remove("rotated");
      toggle.setAttribute("aria-expanded", "false");
    } else {
      submenu?.classList.add("open");
      chevron?.classList.add("rotated");
      toggle.setAttribute("aria-expanded", "true");
    }
  });
</script>
