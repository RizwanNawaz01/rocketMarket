---

<footer class="w-full">
  <!-- CTA Banner -->
  <div class="bg-brand-blue py-16 px-8 flex flex-col md:flex-row items-center justify-between">
    <div class="mb-8 md:mb-0">
      <h2 class="text-white font-heading text-4xl md:text-5xl mb-4">Get clear. Get confident. Grow faster.</h2>
      <p class="text-white text-lg font-body">Tell us what you're working on. No pitch, no pressure.</p>
    </div>
    <a href="/contact" class="bg-brand-navy text-white px-8 py-4 rounded font-bold font-heading text-lg hover:bg-brand-green hover:text-brand-navy transition-colors">
      Book a fit call
    </a>
  </div>

  <!-- Main Footer -->
  <div class="bg-brand-navy py-16 px-8 text-white">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between">
      <div class="mb-12 md:mb-0">
        <h3 class="text-brand-green font-heading text-2xl mb-6">Services</h3>
        <ul class="space-y-4 font-body">
          <li class="flex items-center">
            <svg class="w-5 h-5 text-white mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <a href="/services" class="hover:text-brand-green transition-colors">Web & Brand Positioning</a>
          </li>
          <li class="flex items-center">
            <svg class="w-5 h-5 text-white mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <a href="/services" class="hover:text-brand-green transition-colors">Personal Branding</a>
          </li>
          <li class="flex items-center">
            <svg class="w-5 h-5 text-white mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <a href="/services" class="hover:text-brand-green transition-colors">Social Selling</a>
          </li>
        </ul>
      </div>

      <div class="mb-12 md:mb-0">
        <h3 class="text-brand-green font-heading text-2xl mb-6">Contact</h3>
        <ul class="space-y-4 font-body">
          <li><a href="mailto:taz@hellorocket.co.uk" class="hover:text-brand-green transition-colors">taz@hellorocket.co.uk</a></li>
          <li>07592999711</li>
        </ul>
      </div>

      <div>
        <a href="/" class="inline-block transform -rotate-6">
          <img src="/general/logo-1.png" alt="Rocket Marketing" class="h-20 w-auto" />
        </a>
      </div>
    </div>

    <!-- Copyright Bar -->
    <div class="max-w-6xl mx-auto border-t border-gray-800 mt-16 pt-8 flex flex-col md:flex-row items-center justify-between text-sm text-gray-300">
      <div class="mb-4 md:mb-0 text-center md:text-left">
        © {new Date().getFullYear()} Rocket Marketing Ltd. All rights reserved | <a href="/sitemap" class="hover:text-white transition-colors">Sitemap</a>
      </div>
      <div class="flex items-center space-x-6">
        <a href="#" aria-label="LinkedIn" class="hover:text-brand-green transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />
