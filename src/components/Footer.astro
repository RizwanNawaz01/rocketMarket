---
import { Image } from "astro:assets";
import logoImg from "../assets/general/logo-1.png";
import CTABanner from "./CTABanner.astro";

const cta = {
  heading: "Get clear. Get confident. Grow faster.",
  subtext: "Tell us what you're working on. No pitch, no pressure.",
  buttonText: "Book a call",
  buttonHref: "https://meetings-eu1.hubspot.com/taz-b",
};

const services = [
  { label: "Web & Brand Positioning", href: "/services" },
  { label: "Personal Branding", href: "/services" },
  { label: "Social Selling", href: "/services" },
];

const contact = [
  { label: "taz@hellorocket.co.uk", href: "mailto:taz@hellorocket.co.uk" },
  { label: "07592999711", href: "tel:07592999711" },
];

const socials = [
  {
    label: "LinkedIn",
    href: "#",
    path: "M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z",
  },
  {
    label: "Instagram",
    href: "#",
    path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z",
  },
];

const copyright = {
  company: "Rocket Marketing Ltd",
  sitemapHref: "/sitemap",
};
---

<footer class="w-full">
  <!-- CTA Banner -->
  <CTABanner
    heading={cta.heading}
    subtext={cta.subtext}
    buttonText={cta.buttonText}
    buttonHref={cta.buttonHref}
  />

  <!-- Main Footer -->
  <div class="bg-brand-navy py-16 px-8 text-white">
    <div
      class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between gap-12 md:gap-8"
    >
      <!-- Services -->
      <div class="mb-8 md:mb-0">
        <h3 class="text-brand-green font-heading text-3xl font-semibold mb-6">
          Services
        </h3>
        <ul class="space-y-4 font-body">
          {
            services.map((item) => (
              <li class="flex items-center gap-3">
                <span class="text-white font-bold shrink-0">—</span>
                <a
                  href={item.href}
                  class="text-white hover:text-brand-green transition-colors font-light text-xl"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div class="mb-8 md:mb-0">
        <h3 class="text-brand-green font-heading text-3xl font-semibold mb-6">
          Contact
        </h3>
        <ul class="space-y-4 font-body font-light text-white">
          {
            contact.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="hover:text-brand-green transition-colors text-xl"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Logo -->
      <div>
        <a href="/" class="inline-block transform -rotate-6">
          <Image src={logoImg} alt="Rocket Marketing" class="h-20 w-auto" />
        </a>
      </div>
    </div>

    <!-- Copyright Bar -->
    <div
      class="max-w-6xl mx-auto border-t border-gray-800 mt-16 pt-8 flex flex-col md:flex-row items-center justify-between text-sm text-gray-400 font-body font-light"
    >
      <div class="mb-4 md:mb-0 text-center md:text-left">
        © {new Date().getFullYear()}
        {copyright.company}. All rights reserved |{" "}
        <a
          href={copyright.sitemapHref}
          class="hover:text-white transition-colors">Sitemap</a
        >
      </div>
      <div class="flex items-center space-x-6">
        {
          socials.map((s) => (
            <a
              href={s.href}
              aria-label={s.label}
              class="hover:text-brand-green transition-colors"
            >
              <svg
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d={s.path} clip-rule="evenodd" />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
