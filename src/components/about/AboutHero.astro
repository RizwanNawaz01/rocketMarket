---
import Button from "../Button.astro";
---

<section class="bg-brand-navy pt-32 pb-24 px-8 border-b border-gray-800">
  <div class="max-w-6xl mx-auto flex flex-col items-start">
    <h1
      class="text-5xl md:text-7xl lg:text-[5rem] font-heading mb-8 leading-[1.1] text-white font-bold tracking-tight"
    >
      We build <span class="text-brand-green">brands</span> that last.<br />
      And <span class="text-brand-green">relationships</span> that last longer.
    </h1>

    <p
      class="text-xl md:text-2xl font-body max-w-4xl mb-12 text-gray-300 leading-relaxed font-light"
    >
      Rocket Marketing is a Swansea B2B marketing agency. We deliver social
      selling, personal branding, and web and brand development - for leaders
      serious about growth. Founded in 2023. Every account is led personally by
      Taz, from start to finish.
    </p>

    <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-6">
      <Button href="/contact">Book a fit call</Button>
      <Button href="/case-study" variant="secondary">View our work</Button>
    </div>
  </div>
</section>
