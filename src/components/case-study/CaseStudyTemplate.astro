---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import CTABanner from "../../components/CTABanner.astro";

export interface HighlightCard {
  title: string;
  description: string;
}

export interface ApproachBlock {
  title: string;
  content: string | string[];
}

export interface CaseStudyData {
  hero: {
    headingWhite: string;
    headingGreen: string;
    body: string;
    cta?: {
      label: string;
      href: string;
      variant?: "primary" | "secondary";
    }[];
  };
  overview: {
    heading?: string;
    paragraphs: string[];
    meta: {
      industry: string;
      companySize: string;
      whatWeDid: string[];
    };
  };
  approach: {
    heading?: string;
    intro: string;
    blocks: ApproachBlock[];
  };
  ctaBanner?: {
    heading: string;
    subtext: string;
    buttonText: string;
    buttonHref: string;
  };
  result: {
    heading?: string;
    intro: string;
    cards: HighlightCard[];
    quote?: {
      text: string;
      author: string;
    };
  };
}

export interface Props {
  study: CaseStudyData;
}

const { study } = Astro.props;

const defaultCtaBanner = {
  heading: "Want results like these?",
  subtext:
    "Book a discovery call — 30 minutes to work out what you need and what it'll cost.",
  buttonText: "Book a fit call",
  buttonHref: "https://meetings-eu1.hubspot.com/taz-b",
};

const ctaBanner = study.ctaBanner || defaultCtaBanner;
---

<Layout>
  <!-- 1. Hero Section -->
  <section class="bg-brand-navy pt-20 pb-32 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto flex flex-col items-start">
      <h1
        class="text-5xl md:text-7xl lg:text-7xl xl:text-[80px] font-heading mb-8 font-semibold leading-[1.05] text-white"
      >
        {study.hero.headingWhite}{" "}
        <span class="text-brand-green">{study.hero.headingGreen}</span>
      </h1>

      <p
        class="text-xl md:text-2xl lg:text-3xl font-body max-w-5xl mb-12 text-white font-light lg:leading-snug"
      >
        {study.hero.body}
      </p>

      {
        study.hero.cta && study.hero.cta.length > 0 && (
          <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-6">
            {study.hero.cta.map((btn) => (
              <Button
                href={btn.href}
                variant={btn.variant as "primary" | "secondary"}
              >
                {btn.label}
              </Button>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- 2. Project Overview -->
  <section class="bg-brand-navy text-white py-24 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto flex flex-col lg:flex-row gap-16">
      <div class="lg:w-2/3">
        <h2 class="font-heading text-4xl md:text-5xl text-brand-green mb-8">
          {study.overview.heading || "Project Overview"}
        </h2>
        <div class="font-body text-lg text-white space-y-6">
          {study.overview.paragraphs.map((para) => <p>{para}</p>)}
        </div>
      </div>

      <!-- Right Meta Info -->
      <div class="lg:w-1/3 space-y-12">
        <div>
          <h3 class="font-heading text-3xl font-bold mb-4 text-brand-green">
            Industry
          </h3>
          <p class="font-body text-white">{study.overview.meta.industry}</p>
        </div>
        <div>
          <h3 class="font-heading text-3xl font-bold mb-4 text-brand-green">
            Company size
          </h3>
          <p class="font-body text-white">{study.overview.meta.companySize}</p>
        </div>
        <div>
          <h3 class="font-heading text-3xl font-bold mb-4 text-brand-green">
            What we did
          </h3>
          <ul class="font-body text-white space-y-2">
            {study.overview.meta.whatWeDid.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Our Approach -->
  <section class="bg-brand-navy text-white py-24 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl text-brand-green mb-8">
        {study.approach.heading || "Our approach"}
      </h2>
      <p class="font-body text-xl text-white mb-16 max-w-4xl leading-relaxed">
        {study.approach.intro}
      </p>

      <div class="space-y-16">
        {
          study.approach.blocks.map((block) => (
            <div>
              <h3 class="font-heading text-3xl font-bold mb-6 text-brand-green">
                {block.title}
              </h3>
              {Array.isArray(block.content) ? (
                <div class="font-body text-lg text-white space-y-6 max-w-4xl leading-relaxed">
                  {block.content.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              ) : (
                <p class="font-body text-lg text-white leading-relaxed max-w-4xl">
                  {block.content}
                </p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. CTA Banner -->
  <CTABanner
    heading={ctaBanner.heading}
    subtext={ctaBanner.subtext}
    buttonText={ctaBanner.buttonText}
    buttonHref={ctaBanner.buttonHref}
  />

  <!-- 5. The Result -->
  <section class="bg-brand-navy text-white py-24 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl text-brand-green mb-8">
        {study.result.heading || "The Result"}
      </h2>
      <p class="font-body text-xl text-white mb-16 max-w-4xl leading-relaxed">
        {study.result.intro}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-24">
        {
          study.result.cards.map((card) => (
            <div class="bg-brand-ice rounded-3xl p-8 text-brand-navy">
              <h4 class="font-heading text-2xl font-bold mb-4">{card.title}</h4>
              <p class="font-body">{card.description}</p>
            </div>
          ))
        }
      </div>

      {
        study.result.quote && (
          <div class="max-w-4xl border-t border-gray-800 pt-12">
            <p class="font-heading text-2xl mb-6 leading-relaxed">
              "{study.result.quote.text}"
            </p>
            <p class="font-body text-brand-green">
              {study.result.quote.author}
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>
