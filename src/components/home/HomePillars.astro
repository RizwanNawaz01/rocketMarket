---
const pillars = [
  {
    title: "1. Positioning",
    body: "Optimising your positioning is the foundation that makes you look the business and mean the part. Clean and intentional positioning signals that you're an established pro.",
  },
  {
    title: "2. Content",
    body: "Your LinkedIn personal brand helps your potential buyers show who you are, why you exist, how you help, & that you're fun to follow.",
  },
  {
    title: "3. Outreach",
    body: "When your messages focus on curiosity, value, and low-risk next steps, you can start conversations with ideal clients without feeling salesy.",
  },
];
---

<section class="bg-brand-navy py-20 md:py-24 md:pt-14 px-8">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        pillars.map((pillar) => (
          <div class="bg-brand-ice rounded-[10px] p-8 md:p-10 text-brand-navy flex flex-col justify-start shadow-lg">
            <h3 class="font-heading text-2xl md:text-3xl font-semibold mb-4 text-brand-navy leading-tight">
              {pillar.title}
            </h3>
            <p class="font-body text-base md:text-lg leading-relaxed text-brand-navy/85 font-normal">
              {pillar.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
