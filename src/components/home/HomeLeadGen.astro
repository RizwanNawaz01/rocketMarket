---
import { Image } from "astro:assets";
import Button from "../../components/Button.astro";
import leadGenImg from "../../assets/general/leadgen-image.jpg";
---

<section class="flex flex-col">
  <!-- Top Blue Banner -->
  <div class="bg-brand-blue text-white py-12 md:py-16 px-8">
    <div
      class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8 md:gap-16"
    >
      <div class="max-w-3xl flex-grow">
        <h2
          class="font-heading text-4xl md:text-5xl mb-4 font-bold tracking-tight text-white"
        >
          Making your growth feel easier
        </h2>
        <p class="font-body text-xl md:text-2xl font-light">
          Book a discovery call — 30 minutes to work out what you need<br
            class="hidden md:block"
          />
          and what it'll cost.
        </p>
      </div>
      <div class="shrink-0 w-full md:w-auto">
        <a
          href="/contact"
          class="bg-[#1f2937] hover:bg-black text-white px-12 py-4 rounded font-bold font-heading text-lg transition-colors inline-block text-center w-full md:w-auto shadow-lg"
        >
          Book a fit call
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Navy Section -->
  <div class="bg-brand-navy text-white py-24 px-8 border-t border-gray-800">
    <div
      class="max-w-6xl mx-auto flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-16"
    >
      <div class="lg:w-[55%] flex flex-col items-start text-left shrink-0">
        <h2 class="font-heading text-4xl lg:text-[3rem] mb-2 font-bold text-white leading-tight">
          Growing a business is hard.
        </h2>
        <h2
          class="font-heading text-4xl lg:text-[3rem] text-brand-green mb-8 font-bold leading-tight"
        >
          Rocket makes it easier.
        </h2>
        <p
          class="font-body text-xl mb-12 text-gray-300 leading-relaxed font-light"
        >
          This free E-book gives you a practical toolkit of<br class="hidden lg:block" />
          resources to help you sharpen your positioning,<br class="hidden lg:block" />
          improve your content, and present your<br class="hidden lg:block" />
          business more professionally.
        </p>
        <div>
          <Button href="/contact"> Book a fit call </Button>
        </div>
      </div>
      <div class="lg:w-[45%] w-full">
        <Image
          src={leadGenImg}
          alt="Writing in notebook"
          class="w-full aspect-[4/3] object-cover"
        />
      </div>
    </div>
  </div>
</section>
