---
import { Image } from "astro:assets";
import Button from "../Button.astro";
import CTABanner from "../CTABanner.astro";
import eBookImg from "../../assets/general/ebook-growth-kit.jpg";

const cta = {
  heading: "Making your growth feel easier",
  subtext:
    "Book a discovery call — 30 minutes to work out what you need and what it'll cost.",
  buttonText: "Book a call",
  buttonHref: "https://meetings-eu1.hubspot.com/taz-b",
};

const leadgen = {
  headingWhite: "Growing a business is hard.",
  headingGreen: "Rocket makes it easier.",
  body: "Download our free E-book, which gives you a practical toolkit of resources to help you sharpen your positioning, improve your content, and present your business more professionally.",
  buttonText: "Get it now",
  buttonHref: "/leadgen",
  imageAlt: "The Ultimate LinkedIn B2B Growth Kit E-book",
};
---

<section class="flex flex-col">
  <!-- Top Blue Banner -->
  <CTABanner
    heading={cta.heading}
    subtext={cta.subtext}
    buttonText={cta.buttonText}
    buttonHref={cta.buttonHref}
  />

  <!-- Bottom Navy Section -->
  <div
    class="bg-brand-navy text-white py-20 md:py-24 px-8 border-t border-gray-800"
  >
    <div
      class="max-w-6xl mx-auto flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-16"
    >
      <div class="lg:w-[55%] flex flex-col items-start text-left shrink-0">
        <h2
          class="font-heading text-[34px] md:text-[44px] font-semibold text-white leading-tight mb-1"
        >
          {leadgen.headingWhite}
        </h2>
        <h2
          class="font-heading text-[34px] md:text-[44px] font-semibold text-brand-green mb-8 leading-tight"
        >
          {leadgen.headingGreen}
        </h2>
        <p
          class="font-body text-lg md:text-xl text-white font-light leading-relaxed mb-10 max-w-xl"
        >
          {leadgen.body}
        </p>
        <div>
          <Button href={leadgen.buttonHref}>{leadgen.buttonText}</Button>
        </div>
      </div>
      <div class="lg:w-[45%] w-full flex justify-center">
        <Image
          src={eBookImg}
          alt={leadgen.imageAlt}
          class="w-full max-w-[420px] aspect-[4/5] object-contain rounded-2xl shadow-2xl drop-shadow-2xl"
        />
      </div>
    </div>
  </div>
</section>
