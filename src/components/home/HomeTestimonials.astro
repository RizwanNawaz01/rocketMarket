---
const companies = [
  "Earnly",
  "High Performance Journey",
  "Simba AI",
  "DecarbN Analytics",
  "XME Digital",
  "Octopus Energy",
  "Ibiza Songs",
  "Legal Eagle",
  "Redrow",
  "Rewired to Grow",
  "ReSpeak",
  "Earnly",
  "High Performance Journey",
  "Simba AI",
  "DecarbN Analytics",
  "XME Digital",
  "Octopus Energy",
  "Ibiza Songs",
  "Legal Eagle",
  "Redrow",
  "Rewired to Grow",
  "ReSpeak",
];

const testimonials = [
  {
    quote:
      "Taz took my scattered thoughts about tax and cash-flow and turned them into a clear founder story that people actually care about. Within a few weeks, I could feel the shift.",
    author: "Adam Marsh",
    title: "Founder - Earnly",
    link: "/case-study",
  },
  {
    quote:
      "A great experience working with Rocket. Their support was invaluable in helping us achieve our business goals. Brought clarity and consistency to our outreach.",
    author: "Phil Holdcroft",
    title: "Founder - High Performance Journey",
    link: "/case-study",
  },
];
---

<section
  class="bg-brand-navy text-white pb-24 pt-0 px-8 border-t border-gray-800"
>
  <!-- Mini Notification Banner matching meetbob -->
  <div class="bg-[#121c32] py-4 px-8 border-b border-gray-800/80 mb-16 -mx-8 text-center">
    <p class="font-body text-base md:text-lg text-gray-200">
      Want to know how much branding costs generally?{" "}
      <a
        href="/how-much-does-branding-cost-uk"
        class="text-white underline font-medium hover:text-brand-green transition-colors"
      >
        read our article
      </a>
    </p>
  </div>

  <div class="max-w-6xl mx-auto">
    <h2
      class="font-heading text-[34px] md:text-[44px] text-brand-green font-semibold mb-16 text-left leading-tight"
    >
      Who we have worked with
    </h2>

    <!-- Infinite Marquee for Companies -->
    <div class="mb-24 mask-edges w-full overflow-hidden">
      <div class="marquee-track flex items-center gap-12 md:gap-24">
        {
          companies.map((company) => (
            <span class="font-bold text-lg md:text-xl uppercase tracking-widest text-gray-400 shrink-0">
              {company}
            </span>
          ))
        }
      </div>
    </div>

    <!-- 2 Testimonials Side-by-Side -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16">
      {
        testimonials.map((t) => (
          <div class="flex items-start">
            <div class="text-brand-green text-[5rem] md:text-[6rem] font-serif font-black leading-none mr-6 md:mr-8 mt-[-1rem] shrink-0">
              “
            </div>
            <div class="flex-grow pr-4">
              <p class="text-xl md:text-2xl font-heading mb-8 leading-snug font-semibold text-white/95">
                {t.quote}
              </p>
              <p class="text-brand-green text-lg md:text-xl font-heading font-semibold mb-1">
                {t.author}
              </p>
              <p class="text-base md:text-lg font-body mb-6 text-white/80">
                {t.title}
              </p>
              <a
                href={t.link}
                class="text-brand-green underline font-semibold text-base hover:text-white transition-colors inline-block"
              >
                Read full case study
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Edge fading for marquee */
  .mask-edges {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  /* Infinite scrolling animation */
  .marquee-track {
    width: max-content;
    animation: scroll 28s linear infinite;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
