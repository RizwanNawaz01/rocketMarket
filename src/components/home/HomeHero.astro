---
import Button from "../Button.astro";
---

<section class="bg-brand-navy pt-20 pb-32 px-8">
  <div class="max-w-6xl mx-auto flex flex-col items-start">
    <h1 class="text-5xl md:text-7xl font-heading mb-8 leading-tight text-white">
      Turn your LinkedIn<br />
      into <span class="text-brand-green">pipeline.</span>
    </h1>

    <p
      class="text-xl md:text-2xl font-body max-w-5xl mb-12 text-gray-300 leading-relaxed"
    >
      Rocket Marketing is a Swansea-based B2B marketing agency. We deliver
      social selling, personal branding, and web and brand development - for
      leaders serious about growth. Founded in 2023. Every account is led
      personally by Taz, from start to finish.
    </p>

    <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-6">
      <Button href="/contact">Book a fit call</Button>
      <Button href="/case-study" variant="secondary">View our work</Button>
    </div>
  </div>
</section>
