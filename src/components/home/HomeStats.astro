---
const heading = "Rocket in numbers";

const stats = [
  {
    target: 20,
    suffix: "",
    label: "years B2B marketing<br />experience",
  },
  {
    target: 50,
    suffix: "+",
    label: "B2B professionals and<br />founders supported",
  },
  {
    target: 100,
    suffix: "%",
    label: "of clients reporting clearer,<br />more professional messaging",
  },
];
---

<section id="stats-section" class="bg-brand-blue text-white py-14 px-8">
  <div class="max-w-6xl mx-auto">
    <h2
      class="font-heading text-[36px] md:text-[44px] leading-tight font-semibold mb-16 text-white"
    >
      {heading}
    </h2>
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center md:text-left"
    >
      {
        stats.map((stat) => (
          <div>
            <div class="text-6xl md:text-8xl font-body font-black mb-4 text-center">
              <span class="stat-number" data-target={stat.target}>
                0
              </span>
              {stat.suffix}
            </div>
            <p
              class="text-xl font-bold font-body text-center"
              set:html={stat.label}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const statsSection = document.getElementById("stats-section");
  const statNumbers = document.querySelectorAll(".stat-number");

  if (statsSection && statNumbers.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          statNumbers.forEach((stat) => {
            const target = parseInt(
              stat.getAttribute("data-target") || "0",
              10,
            );
            const duration = 4000; // slower: 6s animation
            const startTime = performance.now();

            const updateNumber = (currentTime: DOMHighResTimeStamp) => {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);

              // easeOutQuart for a smooth decelerating effect
              const easeOut = 1 - Math.pow(1 - progress, 4);

              const current = Math.floor(easeOut * target);
              stat.textContent = current.toString();

              if (progress < 1) {
                requestAnimationFrame(updateNumber);
              } else {
                stat.textContent = target.toString();
              }
            };

            requestAnimationFrame(updateNumber);
          });

          observer.unobserve(statsSection);
        }
      },
      { threshold: 0.3 },
    );

    observer.observe(statsSection);
  }
</script>
