---
export interface OptionItem {
  title: string;
  badge?: string;
  description: string;
  features: string[];
  outcome: string;
}

export interface PricingRow {
  option: string;
  investment: string;
  timeline: string;
  retainer: string;
  bestFor: string;
}

export interface Props {
  problemHeading?: string;
  problemText: string;
  solutionHeading?: string;
  options: OptionItem[];
  pricingHeading?: string;
  pricingRows: PricingRow[];
}

const {
  problemHeading = "The problem... ❌",
  problemText,
  solutionHeading = "The solution... 🌈",
  options,
  pricingHeading = "Web and branding pricing guide 💰",
  pricingRows,
} = Astro.props;
---

<!-- The Problem Section -->
<section class="bg-brand-navy text-white py-16 px-8 border-b border-gray-800">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-heading text-[34px] md:text-[40px] text-brand-green font-semibold mb-8 leading-tight">
      {problemHeading}
    </h2>
    <p class="font-body text-xl md:text-2xl text-white/90 leading-relaxed max-w-5xl font-light">
      {problemText}
    </p>
  </div>
</section>

<!-- The Solution (Options) Section -->
<section class="bg-brand-navy text-white py-16 px-8 border-b border-gray-800">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-heading text-[34px] md:text-[40px] text-brand-green font-semibold mb-12 leading-tight">
      {solutionHeading}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-stretch">
      {options.map((opt) => (
        <div class="bg-[#121c32] border border-gray-800/90 rounded-2xl p-8 md:p-10 flex flex-col justify-between shadow-xl h-full">
          <div>
            <h3 class="font-heading text-2xl md:text-3xl font-bold mb-4 text-white">
              {opt.title}
            </h3>
            <p class="font-body text-base md:text-lg text-white/85 mb-6 leading-relaxed font-light min-h-[56px] sm:min-h-[56px] md:min-h-[60px]">
              {opt.description}
            </p>
            <ul class="space-y-3 font-body text-base md:text-lg mb-8">
              {opt.features.map((feat) => (
                <li class="flex items-start text-white/90">
                  <span class="text-white font-bold mr-3 select-none">•</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>
          {opt.outcome && (
            <div class="pt-6 border-t border-gray-800/80">
              <p class="font-body text-base md:text-lg text-white/95">
                <strong class="font-bold text-white">What you get:</strong>{" "}
                <span class="font-light">{opt.outcome}</span>
              </p>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Pricing Table Section -->
{pricingRows && pricingRows.length > 0 && (
  <section class="bg-brand-navy text-white py-16 px-8 border-b border-gray-800">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-[34px] md:text-[40px] text-brand-green font-semibold mb-12 leading-tight">
        {pricingHeading}
      </h2>

      <!-- Responsive Table Container -->
      <div class="overflow-x-auto rounded-2xl border border-gray-200 shadow-xl">
        <table class="w-full text-left border-collapse bg-white text-brand-navy">
          <thead>
            <tr class="border-b border-gray-200 text-sm md:text-base font-heading font-bold text-brand-navy">
              <th class="py-5 px-6 font-bold">Option</th>
              <th class="py-5 px-6 font-bold">Investment</th>
              <th class="py-5 px-6 font-bold">Timeline</th>
              <th class="py-5 px-6 font-bold">Retainer charge</th>
              <th class="py-5 px-6 font-bold">Best For</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 font-body text-sm md:text-base">
            {pricingRows.map((row) => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="py-6 px-6 font-bold text-brand-navy whitespace-nowrap">
                  {row.option}
                </td>
                <td class="py-6 px-6 font-semibold whitespace-nowrap">
                  {row.investment}
                </td>
                <td class="py-6 px-6 whitespace-nowrap">{row.timeline}</td>
                <td class="py-6 px-6 whitespace-nowrap">{row.retainer}</td>
                <td class="py-6 px-6 text-gray-700 leading-snug">
                  {row.bestFor}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
)}
