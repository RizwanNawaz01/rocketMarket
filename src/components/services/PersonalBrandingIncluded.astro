---
export interface PersonalBrandingData {
  notion: {
    heading: string;
    points: string[];
  };
  visual: {
    heading: string;
    points: string[];
  };
  transformation: {
    heading: string;
    clarityPoints: string[];
  };
  content: {
    heading: string;
    points: string[];
    pillars: string[];
  };
}

export interface Props {
  data: PersonalBrandingData;
}

const { data } = Astro.props;
---

<section class="bg-brand-navy text-white py-16 px-8 border-b border-gray-800">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-heading text-[34px] md:text-[44px] text-brand-green font-semibold mb-12 leading-tight">
      What’s included... ✨
    </h2>

    <!-- 2 Column Grid for Notion OS & Visual Assets -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 mb-12">
      <!-- Card 1: Notion OS -->
      <div class="bg-[#121c32] border border-gray-800/90 rounded-2xl p-8 md:p-10 shadow-xl">
        <h3 class="font-heading text-2xl md:text-3xl font-bold mb-6 text-white flex items-center gap-3">
          {data.notion.heading}
        </h3>
        <ul class="space-y-4 font-body text-base md:text-lg text-white/90">
          {data.notion.points.map((pt) => (
            <li class="flex items-start">
              <span class="text-white font-bold mr-3 select-none">•</span>
              <span class="font-light">{pt}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Card 2: Visual Brand Direction -->
      <div class="bg-[#121c32] border border-gray-800/90 rounded-2xl p-8 md:p-10 shadow-xl">
        <h3 class="font-heading text-2xl md:text-3xl font-bold mb-6 text-white flex items-center gap-3">
          {data.visual.heading}
        </h3>
        <ul class="space-y-4 font-body text-base md:text-lg text-white/90">
          {data.visual.points.map((pt) => (
            <li class="flex items-start">
              <span class="text-white font-bold mr-3 select-none">•</span>
              <span class="font-light">{pt}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 2 Column Grid for Profile Transformation & Content Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      <!-- Card 3: Profile Transformation -->
      <div class="bg-[#121c32] border border-gray-800/90 rounded-2xl p-8 md:p-10 shadow-xl">
        <h3 class="font-heading text-2xl md:text-3xl font-bold mb-4 text-white">
          {data.transformation.heading}
        </h3>
        <p class="font-heading text-lg font-semibold text-brand-green mb-4">Clarity on:</p>
        <ol class="space-y-3 font-body text-base md:text-lg text-white/90">
          {data.transformation.clarityPoints.map((pt, idx) => (
            <li class="flex items-start">
              <span class="text-brand-green font-bold mr-3">{idx + 1}.</span>
              <span class="font-light">{pt}</span>
            </li>
          ))}
        </ol>
      </div>

      <!-- Card 4: Content That Feels Like You -->
      <div class="bg-[#121c32] border border-gray-800/90 rounded-2xl p-8 md:p-10 shadow-xl">
        <h3 class="font-heading text-2xl md:text-3xl font-bold mb-6 text-white">
          {data.content.heading}
        </h3>
        <ul class="space-y-3 font-body text-base md:text-lg text-white/90 mb-6">
          {data.content.points.map((pt) => (
            <li class="flex items-start">
              <span class="text-white font-bold mr-3 select-none">•</span>
              <span class="font-light">{pt}</span>
            </li>
          ))}
        </ul>

        <div class="pt-4 border-t border-gray-800">
          <p class="font-heading text-base font-semibold text-brand-green mb-3">Across 8 strategic pillars:</p>
          <ol class="space-y-2.5 font-body text-sm md:text-base text-white/85">
            {data.content.pillars.map((pil, idx) => (
              <li class="flex items-start">
                <span class="text-brand-green font-bold mr-2.5 shrink-0">{idx + 1}.</span>
                <span class="font-light">{pil}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

